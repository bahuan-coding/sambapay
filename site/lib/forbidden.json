  "licence": {
    "reason": "We never claim a status we do not hold, and we never publish an availability number.",
    "flags": "i",
    "patterns": [
      "we are a sub[- ]acquirer",
      "we are a payment institution",
      "somos (uma )?sub[- ]?(adquirente|credenciador)",
      "somos (uma )?institui\u00e7\u00e3o de pagamento",
      "\\bSLA\\b",
      "\\buptime\\b",
      "\\b99\\.\\d",
      "\\bfour nines\\b",
      "\\bfive nines\\b",
      "\\b\\d+ years without\\b",
      "\\b\\d+ anos sem\\b"
    ]
  },

  "conflict": {
    "reason": "The Website Factory is a capture rule, not an offer rule.",
    "flags": "i",
    "patterns": [
      "merchant acquisition",
      "grow your merchant base",
      "switch to us",
      "\\bmigre para\\b",
      "\\bcadastre[- ]se\\b",
      "\\bsign up\\b",
      "\\bbook a demo\\b",
      "\\bfale com vendas\\b",
      "\\btalk to sales\\b",
      "\\bget started\\b"
    ]
  },

  "figures": {
    "reason": "R$ 3 billion is the only publishable figure, and only inside the learning frame. R$ 2 billion is tied to a named acquirer and stays internal.",
    "banned": ["R\\$\\s?2 (billion|bilh\u00f5es)", "R\\$\\s?5,000", "USD\\s?100,000", "25 million", "100k"],
    "conditional": {
      "pattern": "R\\$\\s?3 (billion|bilh\u00f5es)",
      "requiresOneOf": [
        "taught",
        "learned",
        "before the system we run today",
        "ensinou",
        "aprender",
        "antes de existir o sistema"
      ]
    }
  },

  "coRequired": {
    "reason": "Any page that speaks of merchants must carry the two-niche line on the same page.",
    "rules": [
      {
        "trigger": "\\b(merchants?|Website Factory)\\b",
        "requiresOneOf": [
          "do not take our clients' merchants",
          "n\u00e3o pegamos os merchants dos nossos clientes",
          "two niches",
          "dois nichos"
        ]
      }
    ]
  }
