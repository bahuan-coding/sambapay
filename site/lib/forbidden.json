{
  "note": "Refusal lists for the public site. Registered 24 Sep 2026 by the site committee (.cursor/skills/sambapay-ceo/references/site-committee.md) and the decision log. Each pattern is a JavaScript regex source string. Flags are per group.",

  "goals": {
    "reason": "The site carries no goal, no date, no target and no strategic discussion. The house register stays in the house.",
    "flags": "i",
    "patterns": [
      "\\bStatus:\\s",
      "\\bOpen:\\s",
      "\\bin discussion\\b",
      "\\broadmap\\b",
      "\\bmilestone",
      "\\bobjectives?\\b",
      "\\btargets?\\b",
      "\\bbreakeven\\b",
      "\\btake rate\\b",
      "ICC\\+\\+",
      "\\bDD1\\b",
      "\\bDD2\\b",
      "\\bcruise\\b",
      "\\bcoming soon\\b",
      "\\bwe will launch\\b",
      "\\bem breve\\b",
      "\\bmeta\\b",
      "\\bcronograma\\b",
      "\\b(janeiro|fevereiro|mar\u00e7o|abril|maio|junho|julho|agosto|setembro|outubro|novembro|dezembro) de 20\\d\\d\\b",
      "\\b\\d{1,2} (January|February|March|April|May|June|July|August|September|October|November|December)\\b",
      "\\bQ[1-4] 20\\d\\d\\b"
    ]
  },

