---
import PlacePage from '../components/PlacePage.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondFold from '../components/SecondFold.astro';
import { shore } from '../data/shore';
---

<PlacePage
  lang="en"
  currentPath="/"
  title="SambaPay"
  frames={shore('en')}
  poster
>
  <h1 slot="sheet">
    <span class="poster-line">Payments in</span>
    <span class="poster-line">Latin America,</span>
    <span class="poster-line poster-line--last">engineered.</span>
  </h1>
  <PrimaryButton slot="sheet" href="/signup" arrow>Create account</PrimaryButton>
  <SecondFold slot="fold" lang="en" />
</PlacePage>
