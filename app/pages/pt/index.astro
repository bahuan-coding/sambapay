---
import PlacePage from '../../components/PlacePage.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import SecondFold from '../../components/SecondFold.astro';
import { shore } from '../../data/shore';
---

<PlacePage
  lang="pt"
  currentPath="/pt/"
  title="SambaPay"
  frames={shore('pt')}
  poster
>
  <h1 slot="sheet">
    <span class="poster-line">A engenharia</span>
    <span class="poster-line">de pagamentos</span>
    <span class="poster-line">na América Latina</span>
  </h1>
  <PrimaryButton slot="sheet" href="/pt/signup" arrow>Criar conta</PrimaryButton>
  <SecondFold slot="fold" lang="pt" />
</PlacePage>
