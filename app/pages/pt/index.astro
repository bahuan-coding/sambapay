---
import PlacePage from '../../components/PlacePage.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import SecondFold from '../../components/SecondFold.astro';
import { shore } from '../../data/shore';
---

<PlacePage
  lang="pt"
  currentPath="/pt/"
  title="SambaPay"
  frames={shore('pt')}
>
  <h1 slot="sheet">Entre na América Latina como um local.</h1>
  <p slot="sheet">Expanda os seus pagamentos, integrados ao ecossistema mais sofisticado e mais eficiente em custo.</p>
  <PrimaryButton slot="sheet" href="/pt/signup">Criar conta</PrimaryButton>
  <SecondFold slot="fold" lang="pt" />
</PlacePage>
