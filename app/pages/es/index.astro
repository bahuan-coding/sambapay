---
import PlacePage from '../../components/PlacePage.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import SecondFold from '../../components/SecondFold.astro';
import { shore } from '../../data/shore';
---

<PlacePage
  lang="es"
  currentPath="/es/"
  title="SambaPay"
  frames={shore('es')}
  poster
>
  <h1 slot="sheet">
    <span class="poster-line">Pagos en</span>
    <span class="poster-line">América Latina,</span>
    <span class="poster-line poster-line--last">ingeniería.</span>
  </h1>
  <PrimaryButton slot="sheet" href="/es/signup" arrow>Crear cuenta</PrimaryButton>
  <SecondFold slot="fold" lang="es" />
</PlacePage>
