---
import MethodIcon from './MethodIcon.astro';
import type { MethodIcon as Kind } from '../data/features';

interface Props {
  items: Kind[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul class="strip" aria-label={label}>
  {items.map((kind) => (
    <li class="strip__item">
      <MethodIcon kind={kind} />
    </li>
  ))}
</ul>

<style>
  .strip {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.15rem;
    margin: 1.5rem 0 0;
    padding: 1.35rem 0 0;
    border-top: 1px solid var(--ink);
  }

  .strip__item {
    display: grid;
    place-items: center;
    height: 2rem;
  }
</style>
