---
import FeatureGroups from './FeatureGroups.astro';
import PrimaryButton from './PrimaryButton.astro';
import ProductMark from './ProductMark.astro';
import type { Lang } from '../i18n';
import { productCopy } from '../data/features';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = productCopy(lang);
---

<section class="catalog" aria-label={copy.seoTitle}>
  <div class="catalog__inner">
    <div class="catalog__grid">
      {copy.columns.map((column) => (
        <article>
          <h2>{column.title}</h2>
          <ul>
            {column.items.map((item) => (
              <li>
                <ProductMark kind={item.mark} />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <FeatureGroups lang={lang} />
    <aside class="catalog__refusal">
      <h2>{copy.refusalTitle}</h2>
      <p>{copy.refusal}</p>
    </aside>
    <p class="catalog__close">{copy.close}</p>
    <PrimaryButton href={copy.ctaHref}>{copy.cta}</PrimaryButton>
  </div>
</section>

<style>
  .catalog {
    background: var(--paper);
    color: var(--ink);
    padding: 2.75rem 0 6rem;
    overflow-x: clip;
  }

  .catalog__inner {
    width: min(76rem, calc(100% - 4rem));
    margin: 0 auto;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  article {
    padding: 1.1rem 1rem 1.25rem;
    border: 1px solid #d0d5dd;
    border-top: 8px solid var(--tone);
    border-radius: 8px;
    background: var(--wash);
  }

  article:nth-child(1) { --tone: var(--green); --wash: #f3faf4; }
  article:nth-child(2) { --tone: var(--ipe); --wash: #fffbeb; }
  article:nth-child(3) { --tone: var(--blue); --wash: #f3f7fd; }
  article:nth-child(4) { --tone: var(--urucum); --wash: #fdf4f2; }

  article h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--tone);
    font-family: var(--display);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--tone);
  }

  article:nth-child(2) h2 { color: var(--anil); }

  article :global(.product-mark circle) { stroke: var(--tone); }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    margin: 0;
  }

  h3 {
    margin: 0.15rem 0 0.35rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  li p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .catalog__refusal {
    margin-top: 4.5rem;
    padding: 1.75rem 1.75rem 1.75rem 1.35rem;
    background: var(--field);
    border-left: 4px solid var(--urucum);
  }

  .catalog__refusal h2 {
    margin: 0 0 0.7rem;
    padding: 0;
    border: 0;
    font-size: 1.65rem;
  }

  .catalog__refusal p {
    margin: 0;
    max-width: 40rem;
    color: var(--ink);
    line-height: 1.5;
  }

  .catalog__close {
    margin: 3.5rem 0 1.5rem;
    max-width: 36rem;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  @media (max-width: 1100px) {
    .catalog__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .catalog { padding: 3.5rem 0 4rem; }
    .catalog__inner { width: min(76rem, calc(100% - 2rem)); }
    .catalog__grid { grid-template-columns: 1fr; }
  }
</style>
