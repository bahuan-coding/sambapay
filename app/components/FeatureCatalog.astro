---
import FeatureGroups from './FeatureGroups.astro';
import LineMark from './LineMark.astro';
import PaymentStrip from './PaymentStrip.astro';
import PrimaryButton from './PrimaryButton.astro';
import type { Lang } from '../i18n';
import { productCopy } from '../data/features';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = productCopy(lang);
---

<section class="catalog" aria-label={copy.seoTitle}>
  <div class="catalog__inner">
    <div class="catalog__bodymap" aria-hidden="true">
      <span class="catalog__bodymap-dot"></span>
      <span class="catalog__bodymap-line"></span>
    </div>
    <div class="catalog__grid">
      {copy.columns.map((column, index) => (
        <article>
          <p class="catalog__step">{String(index + 1).padStart(2, '0')}</p>
          <h2>{column.title}</h2>
          <ul>
            {column.items.map((item) => (
              <li>
                <LineMark kind={item.mark} />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
          {column.pay && <PaymentStrip items={column.pay as never[]} />}
        </article>
      ))}
    </div>
    <FeatureGroups lang={lang} />
    <aside class="catalog__refusal">
      <h2>{copy.refusalTitle}</h2>
      <p>{copy.refusal}</p>
    </aside>
    <p class="catalog__close">{copy.close}</p>
    <PrimaryButton href={copy.ctaHref} arrow>{copy.cta}</PrimaryButton>
  </div>
</section>

<style>
  .catalog {
    background: var(--paper);
    color: var(--ink);
    padding: 2.75rem 0 6rem;
    overflow-x: clip;
  }

  .catalog__inner {
    width: min(76rem, calc(100% - 4rem));
    margin: 0 auto;
  }

  .catalog__bodymap {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0 0 3.5rem;
  }

  .catalog__bodymap-dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--ink);
  }

  .catalog__bodymap-line {
    flex: 1;
    height: 1px;
    margin-left: 0.85rem;
    background: linear-gradient(90deg, var(--ink) 0%, rgba(28, 61, 74, 0.12) 100%);
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  article {
    margin: 0;
    padding-top: 1.6rem;
    border-top: 1px solid var(--ink);
  }

  .catalog__step {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--anil);
  }

  article h2 {
    margin: 0 0 1.5rem;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    margin: 0;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border);
  }

  article li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  li :global(.line-mark) {
    --accent: var(--ipe);
    width: 2.25rem;
    height: 2.25rem;
  }

  h3 {
    margin: 0.1rem 0 0.3rem;
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  li p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .catalog__refusal {
    margin-top: 4.5rem;
    padding: 1.75rem 1.75rem 1.75rem 1.35rem;
    background: var(--field);
    border-left: 4px solid var(--urucum);
  }

  .catalog__refusal h2 {
    margin: 0 0 0.7rem;
    padding: 0;
    border: 0;
    font-size: 1.65rem;
  }

  .catalog__refusal p {
    margin: 0;
    max-width: 40rem;
    color: var(--ink);
    line-height: 1.5;
  }

  .catalog__close {
    margin: 3.5rem 0 1.5rem;
    max-width: 40rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  @media (max-width: 1100px) {
    .catalog__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .catalog { padding: 3.5rem 0 4rem; }
    .catalog__inner { width: min(76rem, calc(100% - 2rem)); }
    .catalog__grid { grid-template-columns: 1fr; }
  }
</style>
