---
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<span class="flag">
  {code === 'br' && (
    <svg viewBox="0 0 100 70" aria-hidden="true">
      <rect width="100" height="70" fill="#009440"/>
      <polygon points="50,8.5 91.5,35 50,61.5 8.5,35" fill="#FFCB00"/>
      <circle cx="50" cy="35" r="16" fill="#302681"/>
      <path d="M36 38.5 Q50 31 64 38.5" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round"/>
    </svg>
  )}
  {code === 'gb' && (
    <svg viewBox="0 0 60 30" aria-hidden="true">
      <rect width="60" height="30" fill="#012169"/>
      <path d="M0 0 L60 30 M60 0 L0 30" stroke="#FFFFFF" stroke-width="6"/>
      <path d="M0 0 L60 30 M60 0 L0 30" stroke="#C8102E" stroke-width="2"/>
      <path d="M30 0 V30 M0 15 H60" stroke="#FFFFFF" stroke-width="10"/>
      <path d="M30 0 V30 M0 15 H60" stroke="#C8102E" stroke-width="6"/>
