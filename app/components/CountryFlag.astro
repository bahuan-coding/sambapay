        <circle cx="10.7" cy="10.45" r="0.38"/>
        <circle cx="12.4" cy="9.9" r="0.38"/>
        <circle cx="14.2" cy="9.6" r="0.38"/>
        <circle cx="16" cy="9.6" r="0.38"/>
        <circle cx="17.8" cy="9.9" r="0.38"/>
