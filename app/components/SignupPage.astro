---
import type { Lang } from '../i18n';
import { pathForLang } from '../i18n';
import { signupCopy } from '../i18n/signup';
import { americasOptions } from '../i18n/americas';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from './FormField.astro';
import CountryMultiSelect from './CountryMultiSelect.astro';
import MerchantTypeCards from './MerchantTypeCards.astro';
import FileDrop from './FileDrop.astro';
import StepProgress from './StepProgress.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const copy = signupCopy(lang);
const countries = americasOptions(lang);
const privacyHref = pathForLang('/legal/privacy', lang);
const termsHref = pathForLang('/legal/terms', lang);
---

<BaseLayout lang={lang} currentPath={currentPath} title={copy.title}>
  <div class="signup">
    <header class="signup__head">
      <h1>{copy.h1}</h1>
      <p class="signup__sub">{copy.sub}</p>
    </header>

    <StepProgress steps={copy.steps} />

    <form class="signup__form" data-signup-form novalidate>
      <!-- Step 1 -->
      <section data-panel="1">
        <h2 class="signup__h2">{copy.step1Title}</h2>
        <FormField id="su-name" name="name" label={copy.fields.name} required autocomplete="name" placeholder={copy.fields.namePlaceholder} />
        <FormField id="su-email" name="email" label={copy.fields.email} type="email" required autocomplete="email" placeholder={copy.fields.emailPlaceholder} />
        <FormField id="su-phone" name="phone" label={copy.fields.phone} type="tel" required autocomplete="tel" placeholder={copy.fields.phonePlaceholder} />
        <label class="signup__check" for="su-terms">
          <input id="su-terms" name="terms" type="checkbox" required />
          <span>
            {lang === 'pt' ? 'Concordo com os ' : lang === 'es' ? 'Acepto los ' : 'I agree to the '}
            <a href={termsHref} target="_blank" rel="noopener">{lang === 'pt' ? 'Termos' : lang === 'es' ? 'Términos' : 'Terms'}</a>
            {lang === 'pt' ? ' e a ' : lang === 'es' ? ' y la ' : ' and the '}
            <a href={privacyHref} target="_blank" rel="noopener">{lang === 'pt' ? 'Privacidade' : lang === 'es' ? 'Privacidad' : 'Privacy'}</a>.
          </span>
        </label>
        <button class="signup__btn" type="button" data-next>{copy.next}</button>
      </section>

      <!-- Step 2 -->
      <section data-panel="2" hidden>
        <h2 class="signup__h2">{copy.step2Title}</h2>
        <CountryMultiSelect
          id="su-countries"
          name="countries"
          label={copy.fields.countryFirst}
          options={countries}
          required
          errorId="su-countries-err"
          hint={copy.fields.countriesHint}
        />
        <div class="signup__dyn" data-tax-block></div>
        <MerchantTypeCards id="su-type" name="merchantType" label={copy.fields.merchantType} options={copy.merchantTypes} required errorId="su-type-err" />
        <FormField id="su-company" name="companyName" label={copy.fields.companyName} required autocomplete="organization" placeholder={copy.fields.companyNamePlaceholder} />
        <FormField id="su-site" name="website" label={copy.fields.website} placeholder={copy.fields.websitePlaceholder} />
        <FormField id="su-industry" name="industry" label={copy.fields.industry} placeholder={copy.fields.industryPlaceholder} />
        <p class="signup__error" data-error hidden role="alert"></p>
        <div class="signup__actions">
          <button class="signup__btn signup__btn--ghost" type="button" data-back>{copy.back}</button>
          <button class="signup__btn" type="button" data-next>{copy.next}</button>
        </div>
      </section>

      <!-- Step 3 -->
      <section data-panel="3" hidden>
        <h2 class="signup__h2">{copy.step3Title}</h2>
        <p class="signup__hint">{copy.owners.uboHint}</p>
        <div data-owners></div>
        <button class="signup__add" type="button" data-add-owner>+ {copy.addOwner}</button>
        <p class="signup__error" data-error hidden role="alert"></p>
        <div class="signup__actions">
          <button class="signup__btn signup__btn--ghost" type="button" data-back>{copy.back}</button>
          <button class="signup__btn" type="button" data-next>{copy.next}</button>
        </div>
      </section>

      <!-- Step 4 -->
      <section data-panel="4" hidden>
        <h2 class="signup__h2">{copy.step4Title}</h2>
        <FileDrop id="doc-company" name="companyDoc" label={copy.documents.company} hint={copy.documents.companyHint} required errorId="doc-company-err" />
        <div data-owner-docs></div>
        <FileDrop id="doc-address" name="addressDoc" label={copy.documents.address} hint={copy.documents.addressOptional} errorId="doc-address-err" />
        <FileDrop id="doc-contract" name="contractDoc" label={copy.documents.contract} hint={copy.documents.contractOptional} errorId="doc-contract-err" />

        <fieldset class="signup__declare">
          <legend class="signup__declare-title">{copy.declaration.title}</legend>
          <label class="signup__check">
            <input type="checkbox" name="decl_accurate" required />
            <span>{copy.declaration.accurate}</span>
          </label>
          <label class="signup__check">
            <input type="checkbox" name="decl_authorized" required />
            <span>{copy.declaration.authorized}</span>
          </label>
          <label class="signup__check">
            <input type="checkbox" name="decl_updates" required />
            <span>{copy.declaration.updates}</span>
          </label>
          <div class="signup__declare-row">
            <div class="field">
              <label class="field__label" for="decl-name">{copy.declaration.signer} <span class="field__req">*</span></label>
              <input class="field__input" id="decl-name" name="decl_signer" required />
            </div>
            <div class="field">
              <label class="field__label" for="decl-title">{copy.declaration.signerTitle} <span class="field__req">*</span></label>
              <input class="field__input" id="decl-title" name="decl_signerTitle" required />
            </div>
          </div>
        </fieldset>

        <p class="signup__error" data-error hidden role="alert"></p>
        <div class="signup__actions">
          <button class="signup__btn signup__btn--ghost" type="button" data-back>{copy.back}</button>
          <button class="signup__btn" type="submit">{copy.submit}</button>
        </div>
      </section>

      <!-- Success -->
      <section data-panel="success" hidden>
        <div class="signup__done" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 24l7 7 13-15"/></svg>
        </div>
        <h2 class="signup__h2 signup__h2--center">{copy.successTitle}</h2>
        <p class="signup__sub signup__sub--center">{copy.successBody}</p>
      </section>
    </form>
  </div>
  <script type="application/json" id="signup-copy" set:html={JSON.stringify({
    ownerName: copy.fields.ownerName,
    ownerDoc: copy.fields.ownerDoc,
    ownerDocFile: copy.documents.owner,
    ownerDocFileHint: copy.documents.ownerHint,
    ownerShare: copy.fields.ownerShare,
    ownerPep: copy.fields.ownerPep,
    ownerRole: copy.fields.ownerRole,
    ownerDirector: copy.owners.director,
    ownerUbo: copy.owners.ubo,
    remove: copy.removeOwner,
    lookingUp: copy.lookup.loading,
    lookupNone: copy.lookup.none,
    lookupFound: copy.lookup.found,
    autofillHint: copy.fields.autofillHint,
    declaration: copy.declaration,
    saving: copy.saving,
    uploading: copy.uploading,
    submitLabel: copy.submitLabel,
    errors: copy.errors,
  })} />
</BaseLayout>

<script>
  import { identityFor, applyMask } from '../data/identity';
  import type { ExtraField } from '../data/identity';

  const t = JSON.parse(document.getElementById('signup-copy')?.textContent ?? '{}');
  const form = document.querySelector<HTMLFormElement>('[data-signup-form]')!;
  const panels = [...form.querySelectorAll<HTMLElement>('[data-panel]')];
  const progress = [...document.querySelectorAll<HTMLElement>('[data-progress]')];
  const taxBlock = form.querySelector<HTMLElement>('[data-tax-block]')!;
  const ownersWrap = form.querySelector<HTMLElement>('[data-owners]')!;
  const ownerDocsWrap = form.querySelector<HTMLElement>('[data-owner-docs]')!;
  const initFileDrop = (window as any).initFileDrop as ((el: HTMLElement) => void) | undefined;
  let step = 1;
  let ownerCount = 0;
  let uploadToken = '';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  /** The error banner of the step we are on, never a hidden one. */
  const activeError = () => form.querySelector<HTMLElement>(`[data-panel="${step}"] [data-error]`);

  function setStep(n: number | 'success') {
    panels.forEach((p) => (p.hidden = p.dataset.panel !== String(n)));
    progress.forEach((el) => {
      const v = Number(el.dataset.progress);
      const done = n === 'success' || (typeof n === 'number' && v < n);
      el.classList.toggle('is-active', typeof n === 'number' && v === n);
      el.classList.toggle('is-done', done);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* Selection order matters: the first country the user picks governs the
     identity experience, not the first one in the DOM. */
  let countryOrder: string[] = [];
  function selectedCountries(): string[] {
    const checked = new Set(
      [...form.querySelectorAll<HTMLInputElement>('[data-country-check]:checked')].map((el) => el.value),
    );
    countryOrder = countryOrder.filter((c) => checked.has(c));
    for (const c of checked) if (!countryOrder.includes(c)) countryOrder.push(c);
    return countryOrder;
  }

  /* Tax block: the first selected country governs the experience. */
  const langIndex = () => {
    const l = document.documentElement.lang.slice(0, 2);
    return l === 'pt' ? 1 : l === 'es' ? 2 : 0;
  };
  const i18nValue = (arr: [string, string, string]) => arr[langIndex()];

  /* Values already typed are kept per country, so switching countries never
     erases the user's work. */
  const taxCache = new Map<string, Record<string, string>>();
  let currentPrimary: string | null = null;

  function stashTax() {
    if (!currentPrimary) return;
    const store: Record<string, string> = {};
    taxBlock.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => {
      store[el.name] = el.value;
    });
    taxCache.set(currentPrimary, store);
  }

  function renderTax() {
    const codes = selectedCountries();
    const primary = codes[0];
    stashTax();
    if (!primary) { taxBlock.innerHTML = ''; currentPrimary = null; return; }
    currentPrimary = primary;
    const cfg = identityFor(primary);
    const saved = taxCache.get(primary) ?? {};
    const extras = cfg.extras.map((f: ExtraField) => renderExtra(f)).join('');
    taxBlock.innerHTML = `
      <div class="field">
        <label class="field__label" for="su-tax">${cfg.taxId.name} <span class="field__req">*</span></label>
        <input class="field__input" id="su-tax" name="documentNumber" required placeholder="${esc(cfg.taxId.placeholder)}" maxlength="${cfg.taxId.maxLength}" value="${esc(saved.documentNumber ?? '')}" data-mask="${esc(cfg.taxId.mask)}" data-validate="tax" data-country="${primary}" data-lookup="${primary}" aria-describedby="su-tax-hint su-tax-status" />
        <p class="field__hint" id="su-tax-hint">${esc(cfg.taxId.placeholder)}</p>
        <p class="field__status" id="su-tax-status" data-tax-status hidden></p>
        <p class="field__error" data-field-error hidden role="alert"></p>
      </div>
      ${extras}`;
    // restore extra values too
    taxBlock.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => {
      if (el.name !== 'documentNumber' && saved[el.name]) el.value = saved[el.name];
    });
    bindMasks(taxBlock);
    bindLookup();
  }

  /* When the tax ID is valid, ask the registry and fill what it returns. */
  let lookupTimer = 0;
  function bindLookup() {
    const input = taxBlock.querySelector<HTMLInputElement>('[data-lookup]');
    const status = taxBlock.querySelector<HTMLElement>('[data-tax-status]');
    if (!input || !status) return;
    input.addEventListener('input', () => {
      window.clearTimeout(lookupTimer);
      status.hidden = true;
      input.removeAttribute('data-verified');
      if (!validateDocument(input)) return;
      lookupTimer = window.setTimeout(() => runLookup(input, status), 500);
    });
  }

  async function runLookup(input: HTMLInputElement, status: HTMLElement) {
    const country = input.dataset.lookup!;
    status.hidden = false;
    status.dataset.state = 'loading';
    status.textContent = t.lookingUp;
    try {
      const res = await fetch('/api/lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ country, document: input.value }),
      });
      const data = await res.json();
      if (!data.found || !data.profile) {
        status.dataset.state = 'none';
        status.textContent = t.lookupNone;
        return;
      }
      fillFromProfile(data.profile);
      status.dataset.state = 'ok';
      status.textContent = `${t.lookupFound} ${data.profile.legalName ?? ''}`.trim();
    } catch {
      status.hidden = true;
    }
  }

  /* The profile the registry returned, kept whole so the server can store it.
     Fills every form field the profile maps to, never overwriting what the
     user already typed. */
  let lookupProfile: Record<string, any> | null = null;

  function fillFromProfile(p: Record<string, any>) {
    lookupProfile = p;
    const set = (name: string, value?: string) => {
      if (!value) return;
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      if (el && !el.value.trim()) {
        el.value = value;
        el.dataset.autofilled = 'true';
        el.dispatchEvent(new Event('input', { bubbles: true }));
      }
    };
    set('companyName', p.legalName);
    set('industry', p.industry);
    set('website', p.website);
    const extras = taxBlock.querySelectorAll<HTMLInputElement>('[name]');
    extras.forEach((el) => {
      if (p[el.name]) { el.value = String(p[el.name]); el.dataset.autofilled = 'true'; }
    });
  }

  function renderExtra(f: ExtraField) {
    const label = i18nValue(f.label);
    const req = f.required ? ' <span class="field__req">*</span>' : '';
    const hidden = 'autocomplete="off"';
    if (f.kind === 'select') {
      const opts = (f.options ?? [])
        .map((o) => `<option value="${o.value}"${o.label ? '' : ''}>${esc(i18nValue(o.label))}</option>`)
        .join('');
      return `<div class="field"><label class="field__label" for="ex-${f.name}">${esc(label)}${req}</label><select class="field__input" id="ex-${f.name}" name="${f.name}"${f.required ? ' required' : ''}><option value=""></option>${opts}</select></div>`;
    }
    return `<div class="field"><label class="field__label" for="ex-${f.name}">${esc(label)}${req}</label><input class="field__input" id="ex-${f.name}" name="${f.name}" ${hidden}${f.required ? ' required' : ''} /></div>`;
  }

  /* Owners: one block per person. Document mask from the country. */
  function addOwner() {
    const codes = selectedCountries();
    const cfg = identityFor(codes[0] ?? 'GENERAL');
    ownerCount += 1;
    const idx = ownerCount;
    const block = document.createElement('div');
    block.className = 'signup__owner';
    block.dataset.owner = String(idx);
    block.innerHTML = `
      <div class="signup__owner-head">
        <span class="signup__owner-title">${esc(t.ownerDoc)} · ${idx}</span>
        ${idx > 1 ? `<button type="button" class="signup__owner-remove" data-remove-owner>${esc(t.remove)}</button>` : ''}
      </div>
      <div class="field"><label class="field__label">${esc(t.ownerRole)} <span class="field__req">*</span></label>
        <select class="field__input" name="owner_role_${idx}" required>
          <option value="director">${esc(t.ownerDirector)}</option>
          <option value="ubo">${esc(t.ownerUbo)}</option>
        </select>
      </div>
      <div class="field"><label class="field__label">${esc(t.ownerName)} <span class="field__req">*</span></label><input class="field__input" name="owner_name_${idx}" required /></div>
      <div class="field"><label class="field__label">${esc(cfg.owner.name)} <span class="field__req">*</span></label><input class="field__input" name="owner_doc_${idx}" data-mask="${esc(cfg.owner.mask)}" data-validate="owner" data-country="${codes[0] ?? ''}" required /></div>
      <div class="field"><label class="field__label">${esc(t.ownerShare)} <span class="field__req">*</span></label><input class="field__input" name="owner_share_${idx}" type="number" min="0" max="100" required /></div>
      <label class="signup__check"><input type="checkbox" name="owner_pep_${idx}" /> <span>${esc(t.ownerPep)}</span></label>`;
    ownersWrap.appendChild(block);
    bindMasks(block);
    block.querySelector('[data-remove-owner]')?.addEventListener('click', () => {
      block.remove();
      syncOwnerDocs();
    });
    syncOwnerDocs();
  }

  /** One identification document per owner, mirroring the owners list. */
  function ownerDocMarkup(idx: number): string {
    return `
      <div class="fd" data-file-drop data-doc-type="ownerDoc_${idx}">
        <span class="fd__label">
          <span class="fd__name">${esc(t.ownerDocFile)} · ${idx}</span>
          <span class="fd__req" aria-hidden="true">*</span>
        </span>
        <label class="fd__zone">
          <input class="fd__input" name="ownerDoc_${idx}" type="file" accept="application/pdf,image/jpeg,image/png" data-file-input />
          <span class="fd__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
          </span>
          <span class="fd__text" data-file-text>${esc(t.ownerDocFileHint)}</span>
          <span class="fd__meta" data-file-meta></span>
        </label>
      </div>`;
  }

  function syncOwnerDocs() {
    const ids = [...ownersWrap.querySelectorAll<HTMLElement>('[data-owner]')].map((b) => b.dataset.owner);
    const existing = new Map(
      [...ownerDocsWrap.querySelectorAll<HTMLElement>('[data-doc-type]')]
        .map((el) => [el.dataset.docType!, el]),
    );
    ownerDocsWrap.innerHTML = '';
    for (const idx of ids) {
      const key = `ownerDoc_${idx}`;
      const kept = existing.get(key);
      if (kept) ownerDocsWrap.appendChild(kept);
      else ownerDocsWrap.insertAdjacentHTML('beforeend', ownerDocMarkup(Number(idx)));
    }
    ownerDocsWrap.querySelectorAll<HTMLElement>('[data-file-drop]').forEach((el) => initFileDrop?.(el));
  }

  /* Masks + validation */
  function bindMasks(root: ParentNode) {
    root.querySelectorAll<HTMLInputElement>('[data-mask]').forEach((input) => {
      const mask = input.dataset.mask ?? '';
      input.addEventListener('input', () => {
        const at = input.selectionStart ?? input.value.length;
        input.value = applyMask(input.value, mask);
        if (at <= input.value.length) input.setSelectionRange(at, at);
      });
    });
  }

  function validateDocument(input: HTMLInputElement): boolean {
    const cfg = identityFor(input.dataset.country ?? 'GENERAL');
    const value = input.value.trim();
    if (!value) return false;
    if (input.dataset.validate === 'tax') return !cfg.taxId.validate || cfg.taxId.validate(value);
    return !cfg.owner.validate || cfg.owner.validate(value);
  }

  /* ---- Validation, with a summary at the top of the step and a message under
     each field. No browser bubbles; the flow stays in our hands. ---- */
  function clearErrors(panel: HTMLElement) {
    panel.querySelectorAll('[data-field-error]').forEach((el) => {
      (el as HTMLElement).hidden = true;
      (el as HTMLElement).textContent = '';
    });
    panel.querySelectorAll('[aria-invalid="true"]').forEach((el) => el.removeAttribute('aria-invalid'));
    const summary = panel.querySelector<HTMLElement>('[data-error]');
    if (summary) summary.hidden = true;
  }

  function fieldMessage(field: HTMLElement): string {
    const name = field.getAttribute('name') ?? '';
    if (field instanceof HTMLInputElement && field.dataset.validate) {
      if (!field.value.trim()) return t.errors.required;
      if (name === 'documentNumber') return t.errors.taxId;
      return t.errors.ownerDoc;
    }
    if (field instanceof HTMLInputElement && field.type === 'email') return t.errors.email;
    if (field instanceof HTMLInputElement && field.type === 'url') return t.errors.url;
    return t.errors.required;
  }

  function markInvalid(field: HTMLElement) {
    field.setAttribute('aria-invalid', 'true');
    const holder = field.closest('.field') ?? field.parentElement;
    const err = holder?.querySelector<HTMLElement>('[data-field-error]');
    if (err) { err.textContent = fieldMessage(field); err.hidden = false; }
  }

  function validatePanel(panel: HTMLElement): boolean {
    clearErrors(panel);
    const invalid: HTMLElement[] = [];

    if (panel.dataset.panel === '2' && selectedCountries().length === 0) {
      const err = form.querySelector<HTMLElement>('#su-countries-err');
      if (err) { err.textContent = t.errors.countries; err.hidden = false; }
      invalid.push(taxBlock.querySelector('[data-country-multi]') ?? taxBlock);
    }

    const fields = panel.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required], [data-validate]');
    for (const field of fields) {
      if ((field as HTMLInputElement).disabled) continue;
      const empty = !String((field as HTMLInputElement).value ?? '').trim();
      const bad = empty
        || !field.checkValidity()
        || (field instanceof HTMLInputElement && !!field.dataset.validate && !validateDocument(field));
      if (bad) { markInvalid(field); invalid.push(field); }
    }

    // merchantType: radios are not natively required across the group.
    if (panel.dataset.panel === '2') {
      const chosen = form.querySelector<HTMLInputElement>('[data-merchant-type]:checked');
      if (!chosen) {
        const err = form.querySelector<HTMLElement>('#su-type-err');
        if (err) { err.textContent = t.errors.required; err.hidden = false; }
        invalid.push(form.querySelector<HTMLElement>('[data-merchant-type]') ?? panel);
      }
    }

    // Step 3 needs at least one owner.
    if (panel.dataset.panel === '3' && ownersWrap.children.length === 0) {
      const err = panel.querySelector<HTMLElement>('[data-error]');
      if (err) { err.textContent = t.errors.ownerRequired; err.hidden = false; }
      invalid.push(ownersWrap);
    }

    if (invalid.length === 0) return true;

    const summary = panel.querySelector<HTMLElement>('[data-error]');
    if (summary && summary.hidden && invalid.length > 1) {
      summary.textContent = t.errors.summary;
      summary.hidden = false;
    }
    const first = invalid[0];
    first.scrollIntoView({ behavior: 'smooth', block: 'center' });
    (first.querySelector('input, select') as HTMLElement | null)?.focus({ preventScroll: true });
    first.focus?.({ preventScroll: true });
    return false;
  }

  /* Country change re-renders the tax block (values preserved per country). */
  form.addEventListener('change', (e) => {
    const node = e.target as HTMLElement;
    if (node.matches('[data-country-check]')) renderTax();
  });

  form.querySelectorAll('[data-next]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const panel = form.querySelector<HTMLElement>(`[data-panel="${step}"]`);
      if (panel && !validatePanel(panel)) return;
      if (step === 3 && ownersWrap.children.length === 0) addOwner();
      step += 1;
      if (step === 4) syncOwnerDocs();
      setStep(step);
    }),
  );

  form.querySelectorAll('[data-back]').forEach((btn) =>
    btn.addEventListener('click', () => { step -= 1; setStep(step); }),
  );

  form.querySelector('[data-add-owner]')?.addEventListener('click', addOwner);

  const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  let createdMerchantId: number | null = null;

  function readForm() {
    const owners = [...ownersWrap.querySelectorAll<HTMLElement>('[data-owner]')].map((b) => {
      const i = b.dataset.owner;
      const f = (n: string) => (form.elements.namedItem(n) as HTMLInputElement)?.value.trim() ?? '';
      return {
        fullName: f(`owner_name_${i}`),
        documentNumber: f(`owner_doc_${i}`),
        role: f(`owner_role_${i}`) || 'director',
        ownershipPct: Number(f(`owner_share_${i}`)) || 0,
        isPep: (form.elements.namedItem(`owner_pep_${i}`) as HTMLInputElement)?.checked ?? false,
      };
    });
    const value = (n: string) => (form.elements.namedItem(n) as HTMLInputElement)?.value.trim() ?? '';
    const extras: Record<string, string> = {};
    taxBlock.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => {
      if (el.name !== 'documentNumber' && el.value.trim()) extras[el.name] = el.value.trim();
    });
    return {
      name: value('name'),
      email: value('email'),
      phone: value('phone'),
      terms: (form.elements.namedItem('terms') as HTMLInputElement)?.checked === true,
      merchantType: form.querySelector<HTMLInputElement>('[data-merchant-type]:checked')?.value ?? 'direct',
      companyName: value('companyName'),
      countries: selectedCountries(),
      country: selectedCountries()[0],
      documentNumber: value('documentNumber'),
      website: value('website'),
      industry: value('industry'),
      extras,
      lookup: lookupProfile,
      owners,
      declaration: {
        accurate: (form.elements.namedItem('decl_accurate') as HTMLInputElement)?.checked === true,
        authorized: (form.elements.namedItem('decl_authorized') as HTMLInputElement)?.checked === true,
        updates: (form.elements.namedItem('decl_updates') as HTMLInputElement)?.checked === true,
        signer: value('decl_signer'),
        signerTitle: value('decl_signerTitle'),
      },
      locale: document.documentElement.lang.slice(0, 2),
    };
  }

  async function uploadDocuments(merchantId: number) {
    const inputs = [...form.querySelectorAll<HTMLInputElement>('[data-file-input]')].filter((i) => i.files?.[0]);
    let done = 0;
    for (const input of inputs) {
      const file = input.files![0];
      const fd = new FormData();
      fd.append('merchantId', String(merchantId));
      fd.append('uploadToken', uploadToken);
      fd.append('docType', input.name);
      fd.append('file', file);
      try {
        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        if (res.ok) {
          done += 1;
        } else {
          // Never fail in silence: mark the field the server refused.
          const drop = input.closest<HTMLElement>('[data-file-drop]');
          const err = drop?.querySelector<HTMLElement>('.fd__error');
          drop?.classList.add('has-error');
          if (err && !err.textContent) { err.textContent = t.errors.file; err.hidden = false; }
        }
      } catch {
        const drop = input.closest<HTMLElement>('[data-file-drop]');
        const err = drop?.querySelector<HTMLElement>('.fd__error');
        drop?.classList.add('has-error');
        if (err && !err.textContent) { err.textContent = t.errors.file; err.hidden = false; }
      }
    }
    return { total: inputs.length, done };
  }

  function setBusy(busy: boolean, label?: string) {
    submitBtn.disabled = busy;
    submitBtn.textContent = busy ? (label ?? t.saving) : t.submitLabel;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const panel = form.querySelector<HTMLElement>('[data-panel="4"]');
    if (panel && !validatePanel(panel)) return;

    const banner = activeError();
    if (banner) banner.hidden = true;
    setBusy(true, t.saving);

    try {
      // Create the merchant only once; a retry reuses it and only re-uploads.
      if (createdMerchantId === null) {
        const res = await fetch('/api/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(readForm()),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 409) { showError(t.errors.emailTaken); setBusy(false); return; }
        if (res.status === 400 && data.error === 'tax_id') { showError(t.errors.taxId); setBusy(false); return; }
        if (!res.ok) { showError(t.errors.generic); setBusy(false); return; }
        if (data.emailSent === false) { showError(t.mailFailed); setBusy(false); return; }
        createdMerchantId = data.merchantId ?? null;
        uploadToken = data.uploadToken ?? '';
      }

      if (createdMerchantId !== null) {
        setBusy(true, t.uploading);
        const { total, done } = await uploadDocuments(createdMerchantId);
        if (total > 0 && done < total) { showError(t.errors.upload); setBusy(false); return; }
      }

      setStep('success');
    } catch {
      showError(t.errors.generic);
      setBusy(false);
    }
  });

  function showError(message: string) {
    const banner = activeError();
    if (!banner) return;
    banner.textContent = message;
    banner.hidden = false;
    banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  setStep(1);
</script>

