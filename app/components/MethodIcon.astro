---
import type { MethodIcon as Kind } from '../data/features';

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;
---

<span class="method-icon" aria-hidden={kind === 'spei' || kind === 'pix' ? undefined : 'true'}>
  {kind === 'pix' && <img src="/methods/pix.png" alt="Pix" />}
  {kind === 'boleto' && (
    <svg viewBox="0 0 24 24">
      <path fill="#1C3D4A" d="M3 4h2v16H3zm3 0h1v16H6zm2 0h2v16H8zm3 0h1v16h-1zm2 0h3v16h-3zm4 0h1v16h-1zm2 0h2v16h-2z"/>
    </svg>
  )}
  {kind === 'oxxo' && <img src="/methods/oxxo.svg" alt="" />}
  {kind === 'spei' && <img src="/methods/spei.png" alt="SPEI" />}
  {kind === 'pagofacil' && <img src="/methods/pago-facil.svg" alt="" />}
  {kind === 'visa_secure' && <img src="/methods/visa-secure.png" alt="" />}
  {kind === 'mastercard_id_check' && (
    <span class="id-check">
      <img src="/methods/mastercard-id-check.png" alt="" />
      <span>ID Check</span>
    </span>
  )}
  {kind === 'amex_safekey' && <img src="/methods/amex-safekey.png" alt="" />}
  {kind === 'qra' && <img class="qra" src="/methods/qr-argentina.svg" alt="" />}
  {kind === 'transfer' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M4 8h12M13 5l3 3-3 3M20 16H8M11 13l-3 3 3 3" stroke="#1351B4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  )}
  {(kind === 'credit' || kind === 'debit') && (
    <svg viewBox="0 0 24 24">
      <rect x="2" y="5" width="20" height="14" rx="2" fill="none" stroke="#1C3D4A" stroke-width="1.6"/>
      <path d="M2 9h20" stroke="#1351B4" stroke-width="2"/>
      <rect x="4.5" y="13" width="4" height="3" rx="0.5" fill="#C4890A"/>
    </svg>
  )}
  {kind === 'local' && (
    <svg viewBox="0 0 24 24">
      <rect x="3" y="6" width="4" height="12" rx="1" fill="#1C3D4A"/>
      <rect x="10" y="6" width="4" height="12" rx="1" fill="#1351B4"/>
      <rect x="17" y="6" width="4" height="12" rx="1" fill="#C4890A"/>
    </svg>
  )}
  {kind === 'brought' && (
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="6" cy="16" r="2.2" stroke="#1C3D4A" stroke-width="1.6"/>
      <circle cx="18" cy="7" r="2.2" fill="#1351B4"/>
      <path d="M8 14.5c2.2-.2 3.2-4 6.2-4.6" stroke="#C4890A" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  )}
  {kind === 'prices' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M5 9h8l5 5-8 8-5-5z" stroke="#1C3D4A" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="9" cy="13" r="1" fill="#C4890A"/>
    </svg>
  )}
  {kind === 'capture' && (
    <svg viewBox="0 0 24 24" fill="none">
      <rect x="8" y="2.5" width="8" height="19" rx="2" stroke="#1C3D4A" stroke-width="1.6"/>
      <rect x="10" y="5" width="4" height="4" rx="0.5" fill="#FFCD07"/>
      <circle cx="12" cy="17" r="1.2" fill="#168821"/>
    </svg>
  )}
</span>

<style>
  .method-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
  }

  .method-icon:has(img) {
    width: auto;
    height: auto;
  }

  svg {
    width: 1.85rem;
    height: 1.85rem;
  }

  img {
    display: block;
    height: 2rem;
    width: auto;
  }

  img.qra {
    height: 3.25rem;
  }

  .id-check {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .id-check img {
    height: 2.6rem;
  }

  .id-check span {
    font-family: var(--display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }

  b {
    display: grid;
    place-items: center;
    min-width: 1.85rem;
    height: 1.85rem;
    padding: 0 0.28rem;
    border: 1.5px solid var(--blue);
    border-radius: 4px;
    font-family: var(--display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--blue);
  }

</style>
