---
import type { Lang } from '../i18n';
import { pathForLang } from '../i18n';
import CountryFlag from './CountryFlag.astro';
import PaymentMethodGrid from './PaymentMethodGrid.astro';
import PaymentMethodIcon from './PaymentMethodIcon.astro';
import PrimaryButton from './PrimaryButton.astro';
import { allMethods, marketGroups, marketsCopy } from '../data/markets';
import { methodLabel } from '../data/payment-methods';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups = marketGroups(lang);
const copy = marketsCopy(lang);
const signupHref = pathForLang('/signup', lang);
const allKeys = allMethods();

const coverage = {
  en: {
    eyebrow: 'Coverage',
    title: 'One connection. Every market.',
    lede: 'Cards, instant payments, cash vouchers, bank transfers and wallets, across the whole map. The catalogue grows as each rail goes live.',
  },
  pt: {
    eyebrow: 'Cobertura',
    title: 'Uma conexão. Todos os mercados.',
    lede: 'Cartões, pagamentos instantâneos, boletos, transferências e carteiras, por todo o mapa. O catálogo cresce conforme cada trilho entra no ar.',
  },
  es: {
    eyebrow: 'Cobertura',
    title: 'Una conexión. Todos los mercados.',
    lede: 'Tarjetas, pagos instantáneos, efectivo, transferencias y billeteras, por todo el mapa. El catálogo crece a medida que cada riel entra en producción.',
  },
}[lang];
---

<section class="mk">
  <div class="mk__inner">
    <header class="mk__head">
      <p class="mk__eyebrow">{copy.eyebrow}</p>
      <h2>{copy.mapTitle}</h2>
      <p class="mk__lede">{copy.mapLede}</p>
    </header>

    <aside class="mk__access">
      <h3>{copy.accessTitle}</h3>
      <p>{copy.accessLede}</p>
    </aside>

    <div class="mk__group">
      <header class="mk__ghead">
        <h3>{copy.southTitle}</h3>
        <span class="mk__rule"></span>
      </header>
      <ul class="mk__grid">
        {groups.south.map((market) => (
          <li class="card">
            <img src={market.image} alt="" loading="lazy" decoding="async" style={`object-position:${market.focus}`} />
            <div class="card__veil"></div>
            <div class="card__top">
              <CountryFlag code={market.code} />
              <span class="card__place">{market.name}</span>
            </div>
            <div class="card__face">
              <span class="card__sym">{market.currencySymbol}</span>
              <p class="card__coin">
                <span class="card__coinname">{market.currencyName}</span>
                <span class="card__iso">{market.currency}</span>
              </p>
            </div>
            <div class="card__base">
              <p class="card__note">{market.note}</p>
              <ul class="card__methods">
                {market.methods.slice(0, 6).map((key) => (
                  <li>
                    <PaymentMethodIcon method={key} label={methodLabel(key, lang)} />
                  </li>
                ))}
                {market.methods.length > 6 && (
                  <li class="card__more">+{market.methods.length - 6}</li>
                )}
              </ul>
              <a class="card__credit" href={market.creditHref} rel="noopener">{market.credit}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="mk__group">
      <header class="mk__ghead">
        <h3>{copy.centralTitle}</h3>
        <span class="mk__rule"></span>
      </header>
      <ul class="mk__grid">
        {groups.central.map((market) => (
          <li class="card">
            <img src={market.image} alt="" loading="lazy" decoding="async" style={`object-position:${market.focus}`} />
            <div class="card__veil"></div>
            <div class="card__top">
              <CountryFlag code={market.code} />
              <span class="card__place">{market.name}</span>
            </div>
            <div class="card__face">
              <span class="card__sym">{market.currencySymbol}</span>
              <p class="card__coin">
                <span class="card__coinname">{market.currencyName}</span>
                <span class="card__iso">{market.currency}</span>
              </p>
            </div>
            <div class="card__base">
              <p class="card__note">{market.note}</p>
              <ul class="card__methods">
                {market.methods.slice(0, 6).map((key) => (
                  <li>
                    <PaymentMethodIcon method={key} label={methodLabel(key, lang)} />
                  </li>
                ))}
                {market.methods.length > 6 && (
                  <li class="card__more">+{market.methods.length - 6}</li>
                )}
              </ul>
              <a class="card__credit" href={market.creditHref} rel="noopener">{market.credit}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="mk__corridor">
      <h2>{copy.corridorTitle}</h2>
      <p class="mk__lede">{copy.corridorLede}</p>
      <ol class="mk__steps">
        {copy.corridor.map((step, index) => (
          <li>
            <p class="mk__step">{String(index + 1).padStart(2, '0')}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mk__coverage">
      <div class="mk__map" aria-hidden="true">
        <img src="/maps/latam-plate.jpg" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="mk__coverage-inner">
        <div class="mk__coverage-head">
          <p class="mk__eyebrow">{coverage.eyebrow}</p>
          <h2>{coverage.title}</h2>
          <p class="mk__coverage-lede">{coverage.lede}</p>
        </div>
        <div class="mk__coverage-grid">
          <PaymentMethodGrid keys={allKeys} lang={lang} />
        </div>
      </div>
    </div>

    <aside class="mk__refusal">
      <h2>{copy.refuseTitle}</h2>
      <p>{copy.refuse}</p>
    </aside>

    <div class="mk__cta">
      <div>
        <h2>{copy.ctaTitle}</h2>
        <p>{copy.ctaLede}</p>
      </div>
      <PrimaryButton href={signupHref} arrow>{copy.cta}</PrimaryButton>
    </div>
  </div>
</section>

<style>
  .mk {
    background: var(--paper);
    color: var(--ink);
    padding: 4.5rem 0 6rem;
  }

  .mk__inner {
    width: min(80rem, calc(100% - 4rem));
    margin: 0 auto;
  }

  .mk__eyebrow {
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--anil);
  }

  .mk__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    flex: none;
    background: currentColor;
    opacity: 0.55;
  }

  .mk h2 {
    margin: 0;
    max-width: 16em;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .mk__lede {
    margin: 1.25rem 0 0;
    max-width: 46rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .mk__access {
    margin-top: 3rem;
    padding: 1.9rem 1.9rem 1.9rem 1.5rem;
    background: var(--field);
    border-left: 4px solid var(--blue);
  }

  .mk__access h3 {
    margin: 0 0 0.6rem;
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .mk__access p {
    margin: 0;
    max-width: 48rem;
    line-height: 1.5;
  }

  .mk__group { margin-top: 4.5rem; }

  .mk__ghead {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .mk__ghead h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .mk__rule {
    flex: 1;
    height: 1px;
    background: var(--ink);
    opacity: 0.25;
  }

  .mk__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.9rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    margin: 0;
    overflow: hidden;
    background: var(--field);
    border: 1px solid rgba(28, 61, 74, 0.16);
    border-radius: 2px;
  }

  .card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    filter: grayscale(0.35) contrast(1.05);
    transition: opacity 500ms ease, transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card:hover > img {
    opacity: 0.28;
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .card > img { transition: none; }
    .card:hover > img { transform: none; }
  }

  .card__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(244, 239, 228, 0.65) 0%, rgba(244, 239, 228, 0.25) 45%, rgba(244, 239, 228, 0.7) 100%);
  }

  .card__top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.8rem 0;
  }

  .card__top :global(.flag) {
    flex: none;
    --flag-h: 14px;
    box-shadow: 0 0 0 1px rgba(28, 61, 74, 0.22);
  }

  .card__place {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card__face {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1.1rem 0.8rem 1.2rem;
  }

  .card__sym {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 3.8vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--anil);
    text-shadow: 0 1px 0 rgba(244, 239, 228, 0.65);
  }

  .card__base {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: 0.85rem 0.85rem 0.8rem;
    border-top: 1px solid rgba(28, 61, 74, 0.16);
    background: rgba(244, 239, 228, 0.55);
  }

  .card__coin {
    margin: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .card__coinname {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .card__iso {
    font-family: var(--display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--anil);
    opacity: 0.7;
  }

  .card__note {
    margin: 0 0 0.7rem;
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: center;
    color: var(--muted);
  }

  .card__methods {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.6rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(28, 61, 74, 0.12);
  }

  .card__methods li {
    display: grid;
    place-items: center;
  }

  .card__methods :global(.pm) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .card__more {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--anil);
  }

  .card__credit {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.55rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    opacity: 0.75;
    text-decoration: none;
  }

  .card__credit:hover { opacity: 1; text-decoration: underline; }

  .mk__coverage {
    position: relative;
    margin-top: 5.5rem;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    background: var(--anil);
    color: #f4efe4;
  }

  .mk__map {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mk__map img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    opacity: 0.9;
  }

  .mk__map::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(18, 33, 40, 0.96) 0%, rgba(18, 33, 40, 0.82) 40%, rgba(18, 33, 40, 0.28) 78%, rgba(18, 33, 40, 0.4) 100%);
  }

  .mk__coverage-inner {
    position: relative;
    z-index: 1;
    width: min(80rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: 5.5rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 3.5rem;
    align-items: center;
  }

  .mk__coverage .mk__eyebrow { color: #f4efe4; }

  .mk__coverage h2 {
    max-width: 12em;
    color: #f4efe4;
  }

  .mk__coverage-lede {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgba(244, 239, 228, 0.82);
  }

  .mk__coverage-grid {
    padding: 1.75rem;
    background: rgba(244, 239, 228, 0.06);
    border: 1px solid rgba(244, 239, 228, 0.16);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .mk__coverage-grid :global(.pmg__row) {
    border-top-color: rgba(244, 239, 228, 0.22);
  }

  .mk__coverage-grid :global(.pmg__cat) { color: rgba(244, 239, 228, 0.75); }

  @media (max-width: 900px) {
    .mk__coverage-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding: 4rem 0;
    }
    .mk__map img { object-position: 50% center; }
  }

  .mk__corridor { margin-top: 5rem; }

  .mk__steps {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .mk__steps li {
    margin: 0;
    padding-top: 1.35rem;
    border-top: 1px solid var(--ink);
  }

  .mk__step {
    margin: 0 0 0.7rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--anil);
  }

  .mk__steps h3 {
    margin: 0 0 0.45rem;
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .mk__steps li p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .mk__refusal {
    margin-top: 4.5rem;
    padding: 1.9rem 1.9rem 1.9rem 1.5rem;
    background: var(--field);
    border-left: 4px solid var(--urucum);
  }

  .mk__refusal h2 {
    max-width: none;
    margin-bottom: 0.7rem;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
  }

  .mk__refusal p {
    margin: 0;
    max-width: 46rem;
    line-height: 1.5;
  }

  .mk__cta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.75rem 2.5rem;
    margin-top: 5rem;
    padding-top: 2.75rem;
  }

  .mk__cta::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 8px;
    background: linear-gradient(90deg, var(--green) 0 32%, var(--yellow) 32% 64%, var(--blue) 64% 100%);
  }

  .mk__cta h2 { max-width: 18em; }

  .mk__cta p {
    margin: 1rem 0 0;
    max-width: 34rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .mk__cta :global(.btn) {
    min-height: 48px;
    padding: 0 1.4rem;
    border-radius: 999px;
    font-size: 0.9375rem;
  }

  @media (max-width: 1100px) {
    .mk__grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 900px) {
    .mk__grid { grid-template-columns: repeat(3, 1fr); }
    .mk__steps { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .mk { padding: 3rem 0 4rem; }
    .mk__inner { width: min(80rem, calc(100% - 2rem)); }
    .mk__grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
    .card { min-height: 15rem; }
    .card__face { padding: 1rem 0.7rem 0.8rem; }
    .card__sym { font-size: 2.4rem; }
    .card__base { padding: 0.7rem 0.7rem 0.65rem; }
    .card__note { display: none; }
    .card__methods li { font-size: 0.7rem; }
    .mk__steps { grid-template-columns: 1fr; }
  }
</style>
