---
import type { Mark } from '../data/features';

interface Props {
  kind: Mark;
}

const { kind } = Astro.props;
---

<svg class="product-mark" viewBox="0 0 160 160" aria-hidden="true">
  <circle cx="80" cy="80" r="74" fill="#F4EFE4" stroke="#1351B4" stroke-width="2.25" />
  {kind === 'prices' && (
    <g fill="none" stroke="#1C3D4A" stroke-width="3.25" stroke-linejoin="round">
      <path d="M54 62 h34 l22 22 -34 34 -22 -22 z" />
      <circle cx="74" cy="78" r="4" fill="#C4890A" stroke="none" />
    </g>
  )}
  {kind === 'methods' && (
    <g>
      <rect x="38" y="56" width="84" height="52" rx="7" fill="none" stroke="#1C3D4A" stroke-width="3.25" />
      <path d="M38 72 h84" stroke="#1351B4" stroke-width="8" />
      <rect x="50" y="88" width="22" height="7" rx="2" fill="#C4890A" />
    </g>
  )}
  {kind === 'terminal' && (
    <g>
      <rect x="56" y="34" width="48" height="92" rx="10" fill="none" stroke="#1C3D4A" stroke-width="3.25" />
      <rect x="66" y="46" width="28" height="20" rx="3" fill="#FFCD07" />
      <circle cx="80" cy="104" r="6" fill="#168821" />
    </g>
  )}
  {kind === 'signup' && (
    <g>
      <rect x="50" y="34" width="52" height="84" rx="5" fill="none" stroke="#1C3D4A" stroke-width="3.25" />
      <path d="M62 52 h28 M62 66 h28 M62 78 h18" stroke="#1C3D4A" stroke-width="3" stroke-linecap="round" />
      <circle cx="108" cy="108" r="16" fill="#168821" />
      <path d="M100 108 l6 6 12-14" fill="none" stroke="#F4EFE4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
  {kind === 'connection' && (
    <g fill="none" stroke-width="3.25" stroke-linecap="round">
      <circle cx="52" cy="108" r="12" stroke="#1C3D4A" />
      <circle cx="112" cy="48" r="12" fill="#1351B4" stroke="none" />
      <path d="M64 100 C86 100 78 56 100 56" stroke="#C4890A" />
    </g>
  )}
  {kind === 'rails' && (
    <g>
      <rect x="40" y="42" width="18" height="76" rx="9" fill="#1C3D4A" />
      <rect x="71" y="42" width="18" height="76" rx="9" fill="#1351B4" />
      <rect x="102" y="42" width="18" height="76" rx="9" fill="#C4890A" />
    </g>
  )}
  {kind === 'stock' && (
    <g>
      <rect x="32" y="80" width="38" height="30" rx="3" fill="none" stroke="#1C3D4A" stroke-width="3" />
      <rect x="61" y="52" width="38" height="30" rx="3" fill="#C2412D" />
      <rect x="90" y="80" width="38" height="30" rx="3" fill="none" stroke="#C4890A" stroke-width="3" />
    </g>
  )}
  {kind === 'store' && (
    <g fill="none" stroke-linejoin="round">
      <path d="M42 70 h76 v46 h-76 z" stroke="#1C3D4A" stroke-width="3.25" />
      <path d="M42 70 l14 -18 h48 l14 18" stroke="#1351B4" stroke-width="3.25" />
      <rect x="56" y="84" width="18" height="22" fill="#FFCD07" stroke="none" />
    </g>
  )}
  {kind === 'included' && (
    <g fill="none" stroke="#168821" stroke-width="3.25" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="80" cy="80" r="30" />
      <path d="M66 81 l10 10 20-24" />
    </g>
  )}
  {kind === 'collect' && (
    <g>
      <circle cx="80" cy="80" r="30" fill="none" stroke="#1C3D4A" stroke-width="3.25" />
      <circle cx="80" cy="80" r="9" fill="#FFCD07" />
    </g>
  )}
  {kind === 'steps' && (
    <g>
      <path d="M56 102 L74 84 M90 74 L106 58" fill="none" stroke="#1C3D4A" stroke-width="3" stroke-linecap="round" />
      <circle cx="46" cy="112" r="9" fill="#C4890A" />
      <circle cx="82" cy="78" r="9" fill="#C4890A" />
      <circle cx="116" cy="46" r="11" fill="#168821" />
    </g>
  )}
  {kind === 'book' && (
    <g fill="none" stroke-linecap="round">
      <path d="M38 46 h40 v68 h-40 z M82 46 h40 v68 h-40 z" stroke="#1C3D4A" stroke-width="3.25" />
      <path d="M48 64 h20 M48 78 h20 M92 64 h20 M92 78 h16" stroke="#1351B4" stroke-width="3" />
    </g>
  )}
</svg>

<style>
  .product-mark { width: 3.5rem; height: 3.5rem; }
</style>
