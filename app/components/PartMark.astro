---
interface Props {
  kind: 'stock' | 'store' | 'acquiring' | 'included' | 'documents' | 'merchants' | 'settlement';
}

const { kind } = Astro.props;

const tones: Record<string, string> = {
  stock: 'ipe',
  store: 'blue',
  acquiring: 'blue',
  included: 'green',
  documents: 'ipe',
  merchants: 'urucum',
  settlement: 'green',
};

const tone = tones[kind] ?? 'ink';
---

<span class="part-mark" data-tone={tone} aria-hidden="true">
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="32" cy="32" r="29" class="rim" stroke-width="1.2" />
    {kind === 'stock' && (
      <g>
        <path d="M13 36h11v12H13z" />
        <path d="M40 36h11v12H40z" />
        <path class="tone" d="M25.5 15h11v12h-11z" />
        <path class="tone" d="M25.5 15l5.5-4 5.5 4" />
      </g>
    )}
    {kind === 'store' && (
      <g>
        <path d="M17 27h30v22H17z" />
        <path d="M14 27l5-11h26l5 11" />
        <path class="tone" d="M27 37h10v12H27z" />
      </g>
    )}
    {kind === 'acquiring' && (
      <g>
        <rect x="24" y="11" width="16" height="34" rx="3" />
        <rect class="tone" x="28" y="16" width="8" height="6" rx="1" />
        <path d="M28 44h8" />
        <circle class="tone" cx="32" cy="38" r="2" />
        <path class="tone" d="M14 26l16 12" />
      </g>
    )}
    {kind === 'included' && (
      <g>
        <circle cx="32" cy="32" r="18" />
        <path class="tone" d="M23 32l7 7 13-16" />
      </g>
    )}
    {kind === 'documents' && (
      <g>
        <path d="M20 12h17l7 7v33H20z" />
        <path d="M37 12v7h7" />
        <path d="M26 28h12M26 34h12M26 40h8" />
        <circle class="tone" cx="42" cy="43" r="5" />
        <path class="tone" d="M39.8 43l1.6 1.6 3.2-3.8" />
      </g>
    )}
    {kind === 'merchants' && (
      <g>
        <path d="M16 26h32v24H16z" />
        <path class="tone" d="M12 27l20-14 20 14" />
        <path d="M22 30v20M29 30v20M35 30v20M42 30v20" />
      </g>
    )}
    {kind === 'settlement' && (
      <g>
        <path d="M13 44h38" />
        <circle class="tone" cx="20" cy="44" r="4" />
        <circle class="tone" cx="32" cy="44" r="4" />
        <circle class="tone" cx="44" cy="44" r="4" />
        <path d="M22 15h20v13H22z" />
        <circle class="tone" cx="32" cy="21.5" r="3.4" />
      </g>
    )}
  </svg>
</span>

<style>
  .part-mark {
    --accent: var(--anil);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .part-mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .part-mark .rim {
    stroke: var(--accent);
    opacity: 0.55;
  }

  .part-mark .tone {
    color: var(--accent);
    stroke: var(--accent);
  }

  .part-mark[data-tone='blue'] { --accent: var(--blue); }
  .part-mark[data-tone='green'] { --accent: var(--green); }
  .part-mark[data-tone='ipe'] { --accent: var(--ipe); }
  .part-mark[data-tone='urucum'] { --accent: var(--urucum); }
  .part-mark[data-tone='ink'] { --accent: var(--anil); }
</style>
