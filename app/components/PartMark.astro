---
interface Props {
  kind: 'stock' | 'store' | 'acquiring' | 'included' | 'documents' | 'merchants' | 'settlement';
}

const { kind } = Astro.props;
---

<svg class="part-mark" viewBox="0 0 160 160" aria-hidden="true">
  <circle cx="80" cy="80" r="74" fill="#F4EFE4" stroke="#1351B4" stroke-width="4" />
  {kind === 'stock' && (
    <g>
      <rect x="28" y="78" width="40" height="32" rx="3" fill="#1C3D4A" />
      <rect x="60" y="58" width="40" height="32" rx="3" fill="#C2412D" />
      <rect x="92" y="78" width="40" height="32" rx="3" fill="#C4890A" />
      <path d="M68 58 L80 44 L92 58" fill="#FFCD07" />
    </g>
  )}
  {kind === 'store' && (
    <g>
      <rect x="28" y="40" width="104" height="78" rx="6" fill="#1C3D4A" />
      <rect x="28" y="40" width="104" height="18" fill="#1351B4" />
      <circle cx="40" cy="49" r="3" fill="#F4EFE4" />
      <circle cx="50" cy="49" r="3" fill="#F4EFE4" />
      <rect x="40" y="70" width="36" height="32" rx="2" fill="#FFCD07" />
      <rect x="84" y="72" width="36" height="6" rx="1" fill="#F4EFE4" />
      <rect x="84" y="84" width="28" height="6" rx="1" fill="#F4EFE4" />
    </g>
  )}
  {kind === 'included' && (
    <g>
      <circle cx="80" cy="80" r="32" fill="#168821" />
      <path d="M64 80 l12 12 22-26" fill="none" stroke="#F4EFE4" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
  {kind === 'documents' && (
    <g>
      <rect x="44" y="32" width="64" height="88" rx="4" fill="#FFFFFF" stroke="#1C3D4A" stroke-width="4" />
      <rect x="56" y="48" width="36" height="6" rx="2" fill="#1C3D4A" />
      <rect x="56" y="62" width="40" height="4" rx="1" fill="#5A6A72" />
      <rect x="56" y="74" width="32" height="4" rx="1" fill="#5A6A72" />
      <rect x="56" y="86" width="24" height="4" rx="1" fill="#5A6A72" />
      <circle cx="96" cy="104" r="16" fill="#168821" />
      <path d="M88 104 l6 6 12-14" fill="none" stroke="#F4EFE4" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
  {kind === 'acquiring' && (
    <g>
      <rect x="52" y="28" width="62" height="96" rx="8" fill="#1C3D4A" />
      <rect x="60" y="36" width="46" height="28" rx="3" fill="#FFCD07" />
      <rect x="66" y="44" width="22" height="4" rx="1" fill="#1C3D4A" />
      <rect x="66" y="52" width="12" height="4" rx="1" fill="#1C3D4A" />
      <circle cx="70" cy="80" r="3.5" fill="#F4EFE4" />
      <circle cx="83" cy="80" r="3.5" fill="#F4EFE4" />
      <circle cx="96" cy="80" r="3.5" fill="#F4EFE4" />
      <circle cx="70" cy="94" r="3.5" fill="#F4EFE4" />
      <circle cx="83" cy="94" r="3.5" fill="#F4EFE4" />
      <circle cx="96" cy="94" r="3.5" fill="#168821" />
      <g transform="rotate(-18 48 88)">
        <rect x="18" y="74" width="44" height="28" rx="3" fill="#C2412D" />
        <rect x="24" y="82" width="24" height="4" fill="#F4EFE4" />
      </g>
    </g>
  )}
  {kind === 'merchants' && (
    <g>
      <rect x="36" y="62" width="88" height="58" rx="3" fill="#1C3D4A" />
      <path d="M28 64 L80 28 L132 64 Z" fill="#C2412D" />
      <rect x="46" y="64" width="8" height="18" fill="#F4EFE4" />
      <rect x="66" y="50" width="8" height="32" fill="#F4EFE4" />
      <rect x="86" y="50" width="8" height="32" fill="#F4EFE4" />
      <rect x="106" y="64" width="8" height="18" fill="#F4EFE4" />
      <rect x="48" y="86" width="22" height="16" rx="2" fill="#1351B4" />
      <rect x="86" y="86" width="22" height="34" fill="#FFCD07" />
    </g>
  )}
  {kind === 'settlement' && (
    <g>
      <path d="M28 108 H132" stroke="#E6DFD2" stroke-width="6" stroke-linecap="round" />
      <circle cx="40" cy="108" r="9" fill="#C4890A" />
      <circle cx="80" cy="108" r="9" fill="#C4890A" />
      <circle cx="120" cy="108" r="11" fill="#168821" />
      <rect x="48" y="36" width="64" height="36" rx="4" fill="#1C3D4A" />
      <circle cx="80" cy="54" r="8" fill="#FFCD07" />
    </g>
  )}
</svg>
