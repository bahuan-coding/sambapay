---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: string;
  required?: boolean;
  errorId?: string;
  autocomplete?: string;
  placeholder?: string;
  hint?: string;
  inputmode?: string;
  mask?: string;
}

const {
  id, name, label, type = 'text', required = false, errorId,
  autocomplete, placeholder, hint, inputmode, mask,
} = Astro.props;
const describedBy = [hint ? `${id}-hint` : '', errorId ?? ''].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label class="field__label" for={id}>
    {label}{required && <span class="field__req" aria-hidden="true">*</span>}
  </label>
  <input
    class="field__input"
    id={id}
    name={name}
    type={type}
    required={required}
    autocomplete={autocomplete}
    placeholder={placeholder}
    inputmode={inputmode}
    data-mask={mask}
    aria-describedby={describedBy}
  />
  {hint && <p class="field__hint" id={`${id}-hint`}>{hint}</p>}
  {errorId && <p class="field__error" id={errorId} hidden role="alert" />}
</div>

<style>
  .field { margin-bottom: 1rem; }

  .field__label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .field__req { margin-left: 2px; color: var(--muted); }

  .field__input {
    width: 100%;
    min-height: 46px;
    padding: 0 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }

  .field__input::placeholder { color: #9aa7ad; }

  .field__input:hover { border-color: #c9d1d5; }

  .field__input:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(19, 81, 180, 0.12);
  }

  .field__input:user-invalid {
    border-color: var(--urucum);
    box-shadow: 0 0 0 3px rgba(194, 65, 45, 0.12);
  }

  .field__hint {
    margin: 0.35rem 0 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .field__error {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--urucum);
  }

  .field__error:not([hidden]) { display: block; }
</style>
