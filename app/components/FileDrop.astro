---
interface Props {
  id: string;
  name: string;
  label: string;
  hint?: string;
  required?: boolean;
  errorId?: string;
  accept?: string;
  /** Prompt and messages, so no English is hardcoded in the client. */
  prompt?: string;
  typeError?: string;
  sizeError?: string;
  /** Which document role this is, so the client can relabel it per country. */
  role?: string;
  /** The camera button label; the button only shows on a device with a camera. */
  camera?: string;
  /** The remove label. */
  remove?: string;
}

const {
  id, name, label, hint, required = false, errorId,
  accept = 'application/pdf,image/jpeg,image/png',
  prompt = 'Choose a file or drop it here',
  typeError = 'Use a PDF, JPG or PNG.',
  sizeError = 'The file is over 10 MB.',
  role,
  camera = 'Take a photo',
  remove = 'Remove',
} = Astro.props;
---

<div class="fd" data-file-drop data-doc-type={name} data-doc-role={role} data-msg-type={typeError} data-msg-size={sizeError}>
  <span class="fd__label">
    <span class="fd__name" data-doc-label>{label}</span>
    {required ? <span class="fd__req" aria-hidden="true">*</span> : <span class="fd__opt" data-doc-hint>{hint ?? ''}</span>}
  </span>
  {required && hint ? <p class="fd__hint" data-doc-hint>{hint}</p> : null}
  <label class="fd__zone" for={id}>
    <input class="fd__input" id={id} name={name} type="file" accept={accept} data-file-input />
    <span class="fd__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
    </span>
    <span class="fd__thumb" data-file-thumb hidden aria-hidden="true"></span>
    <span class="fd__text" data-file-text>{prompt}</span>
    <span class="fd__meta" data-file-meta></span>
  </label>
  <div class="fd__actions" data-file-actions hidden>
    <button type="button" class="fd__camera" data-file-camera hidden data-label={camera}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.2"/></svg>
      <span>{camera}</span>
    </button>
    <button type="button" class="fd__clear" data-file-clear>{remove}</button>
  </div>
  {errorId && <p class="fd__error" id={errorId} hidden role="alert" />}
</div>

<style>
  .fd { margin-bottom: 1rem; }

  .fd__label {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .fd__name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
  }

  .fd__req { color: var(--muted); }

  .fd__opt {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .fd__hint {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .fd__zone {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 62px;
    padding: 0.85rem 0.95rem;
    background: var(--paper);
    border: 1.5px dashed var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease;
  }

  .fd__zone:hover { border-color: #c9d1d5; background: var(--field); }

  .fd.is-dragover .fd__zone {
    border-color: var(--blue);
    background: rgba(19, 81, 180, 0.05);
  }

  .fd.is-done .fd__zone {
    border-style: solid;
    border-color: var(--green);
    background: rgba(22, 136, 33, 0.05);
  }

  .fd.has-error .fd__zone { border-color: var(--urucum); }

  .fd__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .fd__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    background: var(--field);
    border-radius: var(--radius);
    color: var(--ink);
  }

  .fd.is-done .fd__icon { background: rgba(22, 136, 33, 0.12); color: var(--green); }

  .fd__text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fd__thumb {
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: var(--radius);
    background-image: var(--thumb);
    background-size: cover;
    background-position: center;
    border: 1px solid var(--border);
  }

  .fd__meta {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .fd__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .fd__actions[hidden] { display: none; }

  .fd__camera,
  .fd__clear {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 38px;
    padding: 0 0.85rem;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .fd__camera {
    border: 1px solid var(--blue);
    background: rgba(19, 81, 180, 0.06);
    color: var(--blue);
  }

  .fd__clear {
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--muted);
  }

  .fd__camera[hidden] { display: none; }

  .fd__error {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--urucum);
  }

  .fd__error:not([hidden]) { display: block; }
</style>

<script>
  const MAX = 10 * 1024 * 1024;
  const OK = ['application/pdf', 'image/jpeg', 'image/png'];

  /** Bind one drop zone. Exported so the signup can add owner zones later. */
  function initFileDrop(drop: HTMLElement) {
    if (drop.dataset.fileBound === 'true') return;
    const input = drop.querySelector<HTMLInputElement>('[data-file-input]');
    const text = drop.querySelector<HTMLElement>('[data-file-text]');
    const meta = drop.querySelector<HTMLElement>('[data-file-meta]');
    const thumb = drop.querySelector<HTMLElement>('[data-file-thumb]');
    const actions = drop.querySelector<HTMLElement>('[data-file-actions]');
    const cameraBtn = drop.querySelector<HTMLButtonElement>('[data-file-camera]');
    const clearBtn = drop.querySelector<HTMLButtonElement>('[data-file-clear]');
    const err = drop.querySelector<HTMLElement>('.fd__error');
    if (!input || !text || !meta) return;
    drop.dataset.fileBound = 'true';
    const promptText = text.textContent ?? '';
    const msgType = drop.dataset.msgType ?? 'Use a PDF, JPG or PNG.';
    const msgSize = drop.dataset.msgSize ?? 'The file is over 10 MB.';

    const fail = (msg: string) => {
      drop.classList.add('has-error');
      drop.classList.remove('is-done');
      if (err) { err.textContent = msg; err.hidden = false; }
    };

    const check = (file: File | undefined) => {
      if (!file) return false;
      if (!OK.includes(file.type)) { fail(msgType); return false; }
      if (file.size > MAX) { fail(msgSize); return false; }
      return true;
    };

    const resetPreview = () => {
      if (thumb) { thumb.hidden = true; thumb.style.removeProperty('--thumb'); }
    };

    const show = (file: File) => {
      if (!check(file)) return;
      drop.classList.remove('has-error');
      drop.classList.add('is-done');
      if (err) err.hidden = true;
      text.textContent = file.name;
      meta.textContent = `${Math.round(file.size / 1024)} KB`;
      if (thumb) {
        if (file.type.startsWith('image/')) {
          const url = URL.createObjectURL(file);
          thumb.style.setProperty('--thumb', `url("${url}")`);
          thumb.hidden = false;
        } else {
          resetPreview();
        }
      }
      if (actions) actions.hidden = false;
    };

    // A phone can shoot the document; a desktop keeps its file picker.
    // The camera input is created on the fly, with the facing camera set.
    input.addEventListener('change', () => show(input.files?.[0] as File));
    if (cameraBtn && window.matchMedia('(pointer: coarse)').matches) {
      cameraBtn.hidden = false;
      cameraBtn.addEventListener('click', () => {
        const cam = document.createElement('input');
        cam.type = 'file';
        cam.accept = input.accept;
        cam.setAttribute('capture', 'environment');
        cam.addEventListener('change', () => {
          const file = cam.files?.[0];
          if (!file) return;
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          show(file);
        });
        cam.click();
      });
    }
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        resetPreview();
        drop.classList.remove('is-done', 'has-error');
        if (err) err.hidden = true;
        text.textContent = promptText;
        meta.textContent = '';
        if (actions) actions.hidden = true;
      });
    }

    ['dragenter', 'dragover'].forEach((ev) =>
      drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('is-dragover'); }),
    );
    ['dragleave', 'drop'].forEach((ev) =>
      drop.addEventListener(ev, () => drop.classList.remove('is-dragover')),
    );
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file && input) {
        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
        show(file);
      }
    });
  }

  (window as any).initFileDrop = initFileDrop;
  document.querySelectorAll<HTMLElement>('[data-file-drop]').forEach(initFileDrop);
</script>
