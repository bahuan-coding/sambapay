---
import { methods, type MethodKey } from '../data/payment-methods';

interface Props {
  method: MethodKey;
  label?: string;
}

const { method, label } = Astro.props;
const meta = methods[method];
const name = label ?? meta.label[0];
const svgSet = new Set(['pago-facil', 'qr-argentina', 'oxxo']);
const ext = meta.svg || svgSet.has(meta.logo) ? 'svg' : 'png';
const src = `/methods/${meta.logo}.${ext}`;
---

<span class="pm" data-category={meta.category} title={name}>
  <img src={src} alt={name} loading="lazy" decoding="async" />
</span>

<style>
  .pm {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .pm img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
