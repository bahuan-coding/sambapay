---
import type { CountryChip } from '../i18n/americas';
import CountryFlag from './CountryFlag.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  options: CountryChip[];
  required?: boolean;
  errorId?: string;
  hint?: string;
}

const { id, name, label, options, required = false, errorId, hint } = Astro.props;
---

<div class="cms">
  <span class="cms__label" id={`${id}-label`}>
    {label}{required && <span class="cms__req" aria-hidden="true">*</span>}
  </span>
  <div class="cms__chips" role="group" aria-labelledby={`${id}-label`} data-country-multi>
    {options.map((opt) => (
      <label class="cms__chip" data-chip data-value={opt.value}>
        <input type="checkbox" name={name} value={opt.value} class="cms__input" data-country-check />
        <CountryFlag code={opt.code.toLowerCase()} />
        <span class="cms__text">{opt.short}</span>
      </label>
    ))}
  </div>
  {hint && <p class="cms__hint">{hint}</p>}
  {errorId && <p class="cms__error" id={errorId} hidden role="alert" />}
</div>

<style>
  .cms { margin-bottom: 1rem; }

  .cms__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
  }

  .cms__req { margin-left: 2px; color: var(--muted); }

  .cms__chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.4rem;
    max-height: 15rem;
    overflow-y: auto;
    padding: 2px;
    margin: -2px;
  }

  .cms__chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 42px;
    padding: 0 0.6rem;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
    transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease;
  }

  .cms__chip:hover { border-color: #c9d1d5; }

  .cms__chip:has(input:checked) {
    border-color: var(--blue);
    background: rgba(19, 81, 180, 0.05);
    box-shadow: 0 0 0 1px var(--blue);
  }

  .cms__chip:has(input:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
  }

  .cms__chip :global(.flag) { --flag-h: 14px; }

  .cms__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cms__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cms__hint {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .cms__error {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--urucum);
  }

  .cms__error:not([hidden]) { display: block; }
</style>
