---
import PartMark from './PartMark.astro';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const pt = lang === 'pt';

const steps = pt
  ? [
      {
        kind: 'stock' as const,
        title: 'O estoque',
        body: 'O negócio traz o estoque. Um marketplace de nicho, ou estoque compartilhado entre lojistas físicos.',
      },
      {
        kind: 'store' as const,
        title: 'A loja online',
        body: 'Digitalizamos a loja onde temos estrutura.',
      },
      {
        kind: 'acquiring' as const,
        title: 'A maquininha',
        body: 'A loja digitalizada já inclui a maquininha para a venda online.',
        href: '/pt/adquirentes',
      },
      {
        kind: 'included' as const,
        title: 'Incluso',
        body: 'O cliente local de cada mercado tem o serviço incluso. Não cobramos a taxa de um marketplace.',
      },
    ]
  : [
      {
        kind: 'stock' as const,
        title: 'The stock',
        body: 'The business brings its stock. A niche marketplace, or stock shared by physical shops.',
      },
      {
        kind: 'store' as const,
        title: 'The online store',
        body: 'We digitise the store where we have structure.',
      },
      {
        kind: 'acquiring' as const,
        title: 'The terminal',
        body: 'The digitised store includes the card terminal for online sales.',
        href: '/acquirers',
      },
      {
        kind: 'included' as const,
        title: 'Included',
        body: 'The local client in each market has the service included. We do not charge a marketplace fee.',
      },
    ];

const label = 'Online enablers';
const previous = pt ? 'Anterior' : 'Previous';
const next = pt ? 'Próximo' : 'Next';
---

<section class="carousel" data-carousel tabindex="0" aria-roledescription="carousel" aria-label={label}>
  <div class="carousel__stage">
    {steps.map((step, index) => (
      <article class="carousel__slide" data-slide hidden={index !== 0} aria-hidden={index !== 0 ? 'true' : 'false'}>
        <PartMark kind={step.kind} />
        <p class="carousel__count">{index + 1} / {steps.length}</p>
        <h2>
          {step.href ? <a href={step.href}>{step.title}</a> : step.title}
        </h2>
        <p>{step.body}</p>
      </article>
    ))}
  </div>
  <div class="carousel__controls">
    <button type="button" class="carousel__nav" data-prev aria-label={previous}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="carousel__dots">
      {steps.map((step, index) => (
        <button
          type="button"
          class="carousel__dot"
          data-dot={index}
          aria-label={`${index + 1}. ${step.title}`}
          aria-current={index === 0 ? 'step' : 'false'}
        />
      ))}
    </div>
    <button type="button" class="carousel__nav" data-next aria-label={next}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll('[data-slide]')];
    const dots = [...root.querySelectorAll('[data-dot]')];
    let index = 0;

    const show = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.hidden = !on;
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', i === index ? 'step' : 'false');
      });
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => show(Number(dot.getAttribute('data-dot'))));
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
    });
  });
</script>

<style>
  .carousel {
    margin-top: var(--space-6);
    max-width: 28rem;
    text-align: center;
    outline: none;
  }

  .carousel:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }

  .carousel__slide {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .carousel__slide[hidden] {
    display: none !important;
  }

  .carousel :global(.part-mark) {
    width: 8.5rem;
    height: 8.5rem;
    background: var(--paper);
    border-radius: 50%;
  }

  .carousel__count {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .carousel h2 {
    margin: var(--space-2) 0 var(--space-2);
    font-size: 1.15rem;
  }

  .carousel h2 a {
    color: inherit;
    text-decoration: none;
  }

  .carousel h2 a:hover {
    text-decoration: underline;
  }

  .carousel__slide p:last-child {
    margin: 0 auto;
    max-width: 24rem;
    min-height: 6.5rem;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .carousel__nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 2px solid var(--blue);
    border-radius: 50%;
    background: var(--paper);
    color: var(--blue);
    cursor: pointer;
  }

  .carousel__nav svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .carousel__nav:hover {
    background: var(--blue);
    color: var(--paper);
  }

  .carousel__nav:focus-visible,
  .carousel__dot:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .carousel__dots {
    display: flex;
    gap: 0.5rem;
  }

  .carousel__dot {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
  }

  .carousel__dot[aria-current='step'] {
    background: var(--blue);
  }
</style>
