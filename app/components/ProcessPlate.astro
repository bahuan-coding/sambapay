---
interface Props {
  kind: 'rails' | 'enable' | 'settle';
}

const { kind } = Astro.props;
const plate = {
  rails: { src: '/process/rails.png?v=9', w: 1280, h: 720 },
  enable: { src: '/process/enable.png?v=9', w: 1280, h: 720 },
  settle: { src: '/process/settle.png?v=10', w: 1280, h: 720 },
}[kind];
---

<img class="plate" src={plate.src} alt="" width={plate.w} height={plate.h} loading="lazy" decoding="async" />

<style>
  .plate {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border-top: 6px solid var(--tone, #1351b4);
    background: #f4efe4;
  }
</style>
