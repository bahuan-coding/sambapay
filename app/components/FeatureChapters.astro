---
import ProcessPlate from './ProcessPlate.astro';
import type { Lang } from '../i18n';
import { productChapters } from '../data/features';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const chapters = productChapters(lang);
---

<div class="chapters">
  {chapters.map((chapter, index) => (
    <section class="chapter" aria-labelledby={`chapter-${index}`}>
      <div class="chapter__copy">
        <p class="chapter__index">{String(index + 1).padStart(2, '0')}</p>
        <h2 id={`chapter-${index}`}>{chapter.title}</h2>
        <p class="chapter__lede">{chapter.lede}</p>
        <ol>
          {chapter.steps.map((step, stepIndex) => (
            <li>
              <p class="chapter__step">{String(stepIndex + 1).padStart(2, '0')}</p>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <ProcessPlate kind={chapter.plate} />
    </section>
  ))}
</div>

<style>
  .chapter {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-top: 3rem;
  }

  @media (min-width: 800px) {
    .chapter {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
      gap: 2.5rem 3.5rem;
      margin-top: 4.5rem;
      align-items: center;
    }
  }

  .chapter:nth-child(1) { --tone: var(--green); }
  .chapter:nth-child(2) { --tone: var(--blue); }
  .chapter:nth-child(3) { --tone: var(--ipe); }

  .chapter__index {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--tone);
  }

  h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }

  .chapter__lede {
    margin: 1rem 0 0;
    max-width: 36rem;
    color: var(--ink);
    line-height: 1.45;
  }

  ol {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.85rem;
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  li + li { margin-top: 0.35rem; }

  .chapter__step {
    margin: 0.2rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--tone);
  }

  h3 {
    margin: 0 0 0.35rem;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  li p:last-child {
    margin: 0;
    max-width: 40rem;
    color: var(--muted);
    line-height: 1.45;
  }

</style>
