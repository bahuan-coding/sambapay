---
import MethodIcon from './MethodIcon.astro';
import PaymentMethodIcon from './PaymentMethodIcon.astro';
import ProcessPlate from './ProcessPlate.astro';
import type { Lang } from '../i18n';
import { productCopy, type MethodIcon as MethodKind } from '../data/features';
import type { MethodKey } from '../data/payment-methods';

function iconsOf(icon?: MethodKind | MethodKind[]) {
  if (!icon) return [];
  return Array.isArray(icon) ? icon : [icon];
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups = productCopy(lang).groups;
---

<div class="groups" data-groups>
  <div class="groups__tabs" role="tablist">
    {groups.map((group, index) => (
      <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-tab={index}>
        {group.title}
      </button>
    ))}
  </div>
  {groups.map((group, index) => (
    <div class="groups__panel" role="tabpanel" hidden={index !== 0} data-panel={index}>
      <p class="groups__lede">{group.lede}</p>
      <div class:list={['groups__split', group.plate && 'groups__split--plate']}>
        <ul>
          {group.items.map((item) => {
            const icons = iconsOf(item.icon);
            const logo = item.methodLogo as MethodKey | undefined;
            const lockup = icons.length === 1 && (icons[0] === 'spei' || icons[0] === 'pix');
            return (
              <li class:list={[(icons.length > 0 || logo) && 'has-icon', logo && 'has-logo', icons.length > 1 && 'schemes', lockup && 'lockup']}>
                {(logo || icons.length > 0) && (
                  <span class:list={['method-icons', icons.length > 1 && 'method-icons--schemes', lockup && 'method-icons--lockup']}>
                    {logo ? <PaymentMethodIcon method={logo} /> : icons.map((kind) => <MethodIcon kind={kind} />)}
                  </span>
                )}
                <div>
                  {item.title && <h3>{item.title}</h3>}
                  <p>{item.body}</p>
                </div>
              </li>
            );
          })}
        </ul>
        {group.plate && <ProcessPlate kind={group.plate} />}
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('[data-groups]').forEach((root) => {
    const tabs = [...root.querySelectorAll('[data-tab]')];
    const panels = [...root.querySelectorAll('[data-panel]')];
    const show = (next) => {
      tabs.forEach((tab, index) => {
        tab.setAttribute('aria-selected', index === next ? 'true' : 'false');
      });
      panels.forEach((panel, index) => {
        panel.hidden = index !== next;
      });
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => show(Number(tab.dataset.tab)));
    });
  });
</script>

<style>
  .groups {
    margin-top: 3.5rem;
  }

  .groups__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--ink);
  }

  button {
    margin: 0;
    padding: 0 0 0.35rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    cursor: pointer;
  }

  button[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--blue);
  }

  button:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .groups__panel {
    padding: 1.25rem 0 0;
  }

  .groups__lede {
    margin: 0 0 1.25rem;
    max-width: 36rem;
    color: var(--ink);
    line-height: 1.45;
  }

  .groups__split {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 800px) {
    .groups__split--plate {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
      align-items: start;
    }
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.5rem 2rem;
  }

  li {
    margin: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  li.has-icon {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .method-icons {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .method-icons--schemes {
    gap: 0.85rem;
  }

  .method-icons--schemes :global(img) {
    height: 3.5rem;
  }

  .method-icons--schemes :global(.id-check img) {
    height: 2.35rem;
  }

  li.schemes h3 {
    font-size: 0.95rem;
  }

  li.schemes p {
    max-width: 28rem;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  li.has-logo .method-icons {
    width: 3.25rem;
    justify-content: flex-start;
  }

  li.has-logo :global(.pm) {
    width: 3.25rem !important;
    height: 3.25rem !important;
    padding: 0.5rem !important;
  }

  li.has-logo h3 {
    font-size: 0.98rem;
  }

  li.has-logo p {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .method-icons--lockup :global(img) {
    height: 4rem;
    width: auto;
  }

  li.lockup p {
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  h3 {
    margin: 0 0 0.25rem;
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  li p {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }
</style>
