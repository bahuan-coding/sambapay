---
type PaymentKind =
  | 'credit'
  | 'debit'
  | '3ds'
  | 'pix'
  | 'boleto'
  | 'spei'
  | 'oxxo'
  | 'qr'
  | 'pagofacil'
  | 'transfer'
  | 'wallet';

interface Props {
  kind: PaymentKind;
  label?: string;
}

const { kind, label } = Astro.props;

const lines: Record<PaymentKind, { tone: string; title: string }> = {
  credit: { tone: 'blue', title: 'Credit card' },
  debit: { tone: 'blue', title: 'Debit card' },
  '3ds': { tone: 'green', title: '3DS' },
  pix: { tone: 'green', title: 'Pix' },
  boleto: { tone: 'ink', title: 'Boleto' },
  spei: { tone: 'green', title: 'SPEI' },
  oxxo: { tone: 'urucum', title: 'OXXO Pay' },
  qr: { tone: 'blue', title: 'QR Argentina' },
  pagofacil: { tone: 'urucum', title: 'Pago Fácil' },
  transfer: { tone: 'blue', title: 'Bank transfer' },
  wallet: { tone: 'ipe', title: 'Wallets' },
};

const meta = lines[kind];
---

<figure class="pay" data-tone={meta.tone}>
  <span class="pay__glyph">
    {kind === 'credit' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="30" height="20" rx="2.5" stroke="currentColor" stroke-width="1.6" />
        <path d="M1 7.5h30" stroke="currentColor" stroke-width="2.4" />
        <rect x="5" y="13" width="6" height="4" rx="1" fill="currentColor" opacity="0.55" />
      </svg>
    )}
    {kind === 'debit' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="30" height="20" rx="2.5" stroke="currentColor" stroke-width="1.6" />
        <circle cx="22" cy="7" r="2.6" stroke="currentColor" stroke-width="1.6" />
        <path d="M5 13h9M5 16.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    )}
    {kind === '3ds' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <path d="M11 4 h10 l4 4 v10 h-18 v-14 z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M11 4 v4 h4" stroke="currentColor" stroke-width="1.6" />
        <path d="m12 13 l2.5 2.5 5 -5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
    {kind === 'pix' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <path d="M16 3 l5 5 -5 5 -5 -5 z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
        <path d="M16 13 l5 5 -5 5 -5 -5 z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
        <path d="M8 8 l3 3 -3 3 M24 8 l-3 3 3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
    {kind === 'boleto' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <path d="M4 3v16M8 3v16M13 3v16M17 3v16M22 3v16M26 3v16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    )}
    {kind === 'spei' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="26" height="16" rx="2" stroke="currentColor" stroke-width="1.6" />
        <path d="M3 8h26" stroke="currentColor" stroke-width="1.6" />
        <path d="M9 14h6M18 14h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    )}
    {kind === 'oxxo' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <path d="M6 4 h20 l-20 14 h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
    {kind === 'qr' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="8" height="8" stroke="currentColor" stroke-width="1.6" />
        <rect x="21" y="3" width="8" height="8" stroke="currentColor" stroke-width="1.6" />
        <rect x="3" y="11" width="8" height="8" stroke="currentColor" stroke-width="1.6" />
        <path d="M21 11h3v3h-3z M26 16h3 M21 20h3 M27 19v3" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )}
    {kind === 'pagofacil' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <rect x="4" y="3" width="24" height="16" rx="2" stroke="currentColor" stroke-width="1.6" />
        <path d="M16 7v8M13 9.5c0-1 1.3-1.7 3-1.7s3 .7 3 1.7-1.3 1.6-3 1.8-3 .8-3 1.8 1.3 1.7 3 1.7 3-.7 3-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    )}
    {kind === 'transfer' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <path d="M4 8h18M18 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M28 16H10M14 12l-4 4 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
    {kind === 'wallet' && (
      <svg viewBox="0 0 32 22" fill="none" aria-hidden="true">
        <rect x="3" y="4" width="26" height="15" rx="2.5" stroke="currentColor" stroke-width="1.6" />
        <path d="M3 9h26" stroke="currentColor" stroke-width="1.6" />
        <circle cx="23" cy="14" r="2.2" fill="currentColor" opacity="0.6" />
      </svg>
    )}
  </span>
  <figcaption class="pay__label">{label ?? meta.title}</figcaption>
</figure>

<style>
  .pay {
    --tone: var(--ink);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 0.5rem;
    border-top: 1px solid var(--border);
  }

  .pay[data-tone='blue'] { --tone: var(--blue); }
  .pay[data-tone='green'] { --tone: var(--green); }
  .pay[data-tone='urucum'] { --tone: var(--urucum); }
  .pay[data-tone='ipe'] { --tone: var(--ipe); }
  .pay[data-tone='ink'] { --tone: var(--ink); }

  .pay__glyph {
    display: grid;
    place-items: center;
    width: 100%;
    height: 2.25rem;
    color: var(--tone);
  }

  .pay__glyph svg {
    width: 2.5rem;
    height: 1.75rem;
  }

  .pay__label {
    font-family: var(--display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-align: center;
    color: var(--ink);
  }
</style>
