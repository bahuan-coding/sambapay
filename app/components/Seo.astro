---
import type { Lang } from '../i18n';
import { alternatePath, ogLocale } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  currentPath: string;
}

const { title, description, lang, currentPath } = Astro.props;
const site = Astro.site ?? new URL('https://sambapay.tech');
const canonical = new URL(currentPath, site);
const enPath = alternatePath(currentPath, 'en');
const ptPath = alternatePath(currentPath, 'pt');
const esPath = alternatePath(currentPath, 'es');
const others = (['en', 'pt', 'es'] as const).filter((item) => item !== lang);

// One card per language, so a link shared in a chat opens in that language.
const ogImage = new URL(`/og/og-${lang}.jpg?v=3`, site);
const ogAlt = {
  en: 'Rio de Janeiro. Payments across South and Central America, engineered.',
  pt: 'Rio de Janeiro. Pagamentos na América do Sul e Central. Engenharia de verdade.',
  es: 'Rio de Janeiro. Pagos en América del Sur y Central. Pura ingeniería.',
}[lang];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={new URL(enPath, site)} />
<link rel="alternate" hreflang="pt-BR" href={new URL(ptPath, site)} />
<link rel="alternate" hreflang="es" href={new URL(esPath, site)} />
<link rel="alternate" hreflang="x-default" href={new URL(enPath, site)} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="SambaPay" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta property="og:locale" content={ogLocale(lang)} />
{others.map((item) => <meta property="og:locale:alternate" content={ogLocale(item)} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
