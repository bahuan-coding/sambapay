---
import type { Lang } from '../i18n';
import { pathForLang, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PrimaryButton from './PrimaryButton.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const messages = t(lang);
---

<BaseLayout lang={lang} currentPath={currentPath} title={messages.notFound.title}>
  <div class="not-found">
    <img src="/favicon.svg" alt="" width="40" height="40" />
    <h1>{messages.notFound.title}</h1>
    <PrimaryButton href={pathForLang('/', lang)}>{messages.notFound.home}</PrimaryButton>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 28rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .not-found img { margin: 0 auto var(--space-5); }

  .not-found h1 {
    margin: 0 0 var(--space-5);
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
