---
import type { Lang } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import CountryFlag from './CountryFlag.astro';

interface Props {
  lang: Lang;
  currentPath: string;
  title: string;
  image: string;
  place: string;
  country: string;
  flag: string;
  credit: string;
  creditHref: string;
}

const { lang, currentPath, title, image, place, country, flag, credit, creditHref } = Astro.props;
---

<BaseLayout lang={lang} currentPath={currentPath} title={title}>
  <section class="place">
    <img src={image} alt="" />
    <div class="place__stack">
      <div class="place__where">
        <CountryFlag code={flag} />
        <div>
          <a class="place__name" href={creditHref}>{place}</a>
          <p class="place__country">{country}</p>
          <p class="place__credit">{credit}</p>
        </div>
      </div>
      <div class="place__sheet">
        <slot name="sheet" />
      </div>
    </div>
  </section>
  <div class="reading">
    <slot />
  </div>
</BaseLayout>

<style>
  .place {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
  }

  @media (min-width: 768px) {
    .place { min-height: 100vh; }
  }

  .place img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .place__stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-5);
    max-width: 40rem;
  }

  .place__sheet {
    width: 100%;
    padding: var(--space-5);
    background: var(--field);
  }

  .place__where {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 6px 6px;
    background: rgba(16, 22, 20, 0.72);
    border-radius: 2px;
    color: #f4efe4;
  }

  .place__name {
    display: inline-block;
    margin: 0;
    font-family: var(--place);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #f4efe4;
    text-decoration: none;
  }

  .place__name:hover { text-decoration: underline; }

  .place__country {
    margin: 2px 0 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f4efe4;
  }

  .place__sheet :global(h1) {
    margin: 0 0 var(--space-4);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .place__sheet :global(p) {
    margin: 0 0 var(--space-4);
    max-width: 36rem;
  }

  .place__credit {
    margin: 6px 0 0;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: #f4efe4;
  }

  .reading {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .reading :global(p),
  .reading :global(h2) {
    max-width: 42rem;
  }

  .reading :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
    font-family: var(--display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .reading :global(p) { margin: 0 0 var(--space-4); }

  .reading :global(.name) {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .reading :global(.cards) {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    max-width: none;
  }

  @media (min-width: 768px) {
    .reading :global(.cards) { grid-template-columns: repeat(3, 1fr); }
  }

  .reading :global(.card) {
    display: grid;
    grid-template-columns: 4px 1fr;
    background: var(--field);
    border: 1px solid var(--border);
  }

  .reading :global(.card__bar) {
    display: block;
    grid-row: 1 / span 2;
    width: 4px;
  }

  .reading :global(.card h2) {
    margin: var(--space-4) var(--space-4) var(--space-2);
    font-size: 1.15rem;
  }

  .reading :global(.card p) {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    max-width: none;
  }

  .reading :global(.card a) {
    color: inherit;
    text-decoration: none;
  }
</style>
