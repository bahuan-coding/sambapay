---
import type { Lang } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import CountryFlag from './CountryFlag.astro';

interface Frame {
  image: string;
  place: string;
  country: string;
  flag: string;
  credit: string;
  creditHref: string;
  focus?: string;
}

interface Props {
  lang: Lang;
  currentPath: string;
  title: string;
  image?: string;
  place?: string;
  country?: string;
  flag?: string;
  credit?: string;
  creditHref?: string;
  frames?: Frame[];
  display?: boolean;
  /** Product page: no place photograph; title and catalog lead the page. */
  lead?: boolean;
  /** Home: the sheet carries a three-line poster. */
  poster?: boolean;
}

const { lang, currentPath, title, image, place, country, flag, credit, creditHref, frames: passed, display = false, lead = false, poster = false } = Astro.props;
const frames: Frame[] = passed ?? [{
  image: image ?? '',
  place: place ?? '',
  country: country ?? '',
  flag: flag ?? '',
  credit: credit ?? '',
  creditHref: creditHref ?? '',
  focus: 'center center',
}];
const many = frames.length > 1;
const shoreNav = {
  en: { previous: 'Previous country', next: 'Next country' },
  pt: { previous: 'País anterior', next: 'Próximo país' },
  es: { previous: 'País anterior', next: 'Siguiente país' },
}[lang];
const previous = shoreNav.previous;
const next = shoreNav.next;
---

<BaseLayout lang={lang} currentPath={currentPath} title={title}>
  {lead ? (
    <div class="product-page">
      <header class="product-page__hero">
        <slot name="sheet" />
      </header>
      <slot name="fold" />
    </div>
  ) : (
  <>
  <section class:list={['place', display && 'place--display', poster && 'place--poster']} data-shore={many ? '' : undefined}>
    <div class="place__window">
      <div class="place__reel">
        {frames.map((frame) => (
          <img src={frame.image} alt="" style={`object-position:${frame.focus ?? 'center center'}`} />
        ))}
      </div>
    </div>
    {many && (
      <div class="place__nav">
        <button type="button" class="place__arrow" data-prev aria-label={previous}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="place__arrow" data-next aria-label={next}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    )}
    <div class="place__stack">
      <div class="place__captions" aria-live="polite">
        {frames.map((frame, index) => (
          <div class="place__where" data-where hidden={index !== 0}>
            <CountryFlag code={frame.flag} />
            <div>
              <a class="place__name" href={frame.creditHref}>{frame.place}</a>
              <p class="place__country">{frame.country}</p>
              <p class="place__credit">{frame.credit}</p>
            </div>
          </div>
        ))}
      </div>
      {!display && (
        <div class="place__sheet">
          <slot name="sheet" />
        </div>
      )}
    </div>
  </section>
  {display && (
    <div class="place__bill">
      <slot name="sheet" />
    </div>
  )}
  {Astro.slots.has('default') && (
    <div class="reading">
      <slot />
    </div>
  )}
  <slot name="fold" />
  </>
  )}
</BaseLayout>

<script>
  document.querySelectorAll('[data-shore]').forEach((root) => {
    const reel = root.querySelector('.place__reel');
    const slides = [...root.querySelectorAll('[data-where]')];
    if (!reel || slides.length < 2) return;
    let index = 0;
    let timer = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      reel.style.transform = `translateX(${-index * 100}%)`;
      slides.forEach((slide, i) => {
        slide.hidden = i !== index;
      });
    };

    const arm = () => {
      window.clearInterval(timer);
      if (reduced) return;
      timer = window.setInterval(() => show(index + 1), 6500);
    };

    root.querySelector('[data-next]')?.addEventListener('click', () => {
      show(index + 1);
      arm();
    });
    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      show(index - 1);
      arm();
    });
    root.addEventListener('mouseenter', () => window.clearInterval(timer));
    root.addEventListener('mouseleave', arm);
    root.addEventListener('focusin', () => window.clearInterval(timer));
    root.addEventListener('focusout', arm);
    arm();
  });
</script>

<style>
  .place {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
  }

  @media (min-width: 768px) {
    .place { min-height: 100vh; }
  }

  .place__window {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .place__reel {
    display: flex;
    height: 100%;
    transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .place__reel img {
    position: relative;
    flex: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .place__nav {
    position: absolute;
    top: 38%;
    left: 16px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    z-index: 2;
    pointer-events: none;
  }

  .place__arrow {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(16, 22, 20, 0.72);
    color: #f4efe4;
    cursor: pointer;
  }

  .place__arrow svg { width: 22px; height: 22px; }

  .place__arrow:focus-visible {
    outline: 2px solid #f4efe4;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .place__reel { transition: none; }
  }

  .place__stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-5);
    max-width: 40rem;
  }

  .place__sheet {
    width: 100%;
    padding: var(--space-5);
    background: rgba(244, 239, 228, 0.62);
    border: 1px solid rgba(244, 239, 228, 0.4);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .place__where {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 9px 16px 10px 9px;
    background: rgba(16, 22, 20, 0.72);
    border-radius: 2px;
    color: #f4efe4;
  }

  .place__where :global(.flag) {
    margin-top: 7px;
  }

  .place__where[hidden] { display: none !important; }

  .place__name {
    display: inline-block;
    margin: 0;
    font-family: var(--place);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.6rem, 2.8vw, 2.7rem);
    letter-spacing: -0.02em;
    line-height: 0.95;
    color: #f4efe4;
    text-decoration: none;
  }

  .place__name:hover { text-decoration: underline; }

  .place__country {
    margin: 1px 0 0;
    font-family: var(--place);
    font-style: normal;
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f4efe4;
  }

  .place__sheet :global(h1) {
    margin: 0 0 var(--space-4);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .place__sheet :global(p) {
    margin: 0 0 var(--space-4);
    max-width: 36rem;
  }

  .place__credit {
    margin: 5px 0 0;
    font-family: var(--font);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: #f4efe4;
  }

  .reading {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .reading :global(p),
  .reading :global(h2) {
    max-width: 42rem;
  }

  .reading :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
    font-family: var(--display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .reading :global(p) { margin: 0 0 var(--space-4); }

  .reading :global(.name) {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .place--display {
    display: block;
    min-height: 0;
  }

  .place--display .place__window {
    position: relative;
    inset: auto;
    height: 78vh;
    min-height: 26rem;
  }

  .place--display .place__nav {
    top: 0;
    height: 78vh;
    align-items: center;
  }

  .place--display .place__stack {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    margin: 0;
    max-width: none;
  }

  .place__bill {
    width: min(76rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: 2.75rem 0 0;
  }

  .place__bill::before {
    content: '';
    display: block;
    height: 8px;
    margin-bottom: 1.6rem;
    background: linear-gradient(90deg, var(--green) 0 32%, var(--yellow) 32% 64%, var(--blue) 64% 100%);
  }

  .place__bill :global(h1) {
    margin: 0 0 1rem;
    max-width: 12em;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.7rem, 5.6vw, 4.75rem);
    letter-spacing: -0.038em;
    line-height: 0.94;
  }

  .place__bill :global(h1 em) {
    font-style: italic;
    font-weight: 500;
  }

  .place__bill :global(p) {
    margin: 0 0 1.25rem;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .product-page__hero {
    width: min(76rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: 1.75rem 0 0;
  }

  .product-page__hero::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: 1.35rem;
    background: linear-gradient(90deg, var(--green) 0 32%, var(--yellow) 32% 64%, var(--blue) 64% 100%);
  }

  .product-page__hero :global(h1) {
    margin: 0 0 0.75rem;
    max-width: 14em;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 3.8vw, 3.35rem);
    letter-spacing: -0.038em;
    line-height: 0.98;
  }

  .product-page__hero :global(h1 em) {
    font-style: italic;
    font-weight: 500;
  }

  .product-page__hero :global(p) {
    margin: 0 0 1rem;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .product-page :global(.catalog) {
    padding-top: 1.25rem;
  }

  .place--poster {
    min-height: calc(100svh - var(--header-h));
  }

  .place--poster .place__window::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(16, 22, 20, 0.52), rgba(16, 22, 20, 0));
    pointer-events: none;
  }

  .place--poster .place__stack {
    max-width: calc(100% - 2rem);
    gap: 0.85rem;
  }

  .place--poster .place__sheet {
    position: relative;
    width: fit-content;
    max-width: 100%;
    padding: 1.5rem 1.6rem 1.45rem;
    background: rgba(244, 239, 228, 0.82);
    border: 1px solid rgba(28, 61, 74, 0.14);
    box-shadow: 0 30px 70px -34px rgba(16, 22, 20, 0.65);
    backdrop-filter: blur(20px) saturate(1.08);
    -webkit-backdrop-filter: blur(20px) saturate(1.08);
  }

  .place--poster .place__sheet::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: linear-gradient(90deg, var(--green) 0 32%, var(--yellow) 32% 64%, var(--blue) 64% 100%);
  }

  .place--poster .place__sheet :global(h1) {
    margin: 0 0 1.2rem;
    max-width: none;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.7rem, min(6.6vw, 9.6vh), 5.2rem);
    letter-spacing: -0.046em;
    line-height: 0.9;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .place--poster .place__sheet :global(.poster-line) {
    display: block;
  }

  .place--poster .place__sheet :global(.poster-line--last) {
    font-style: italic;
    font-weight: 500;
  }

  .place--poster .place__sheet :global(.btn) {
    min-height: 44px;
    padding: 0 1.05rem 0 1.2rem;
    border-radius: 999px;
    background: var(--ink);
    color: #f4efe4;
    border-color: transparent;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .place--poster .place__sheet :global(.btn:hover) {
    background: var(--blue);
    color: #f4efe4;
  }

  @media (max-width: 767px) {
    .place--poster .place__stack { margin: 0.85rem; }
    .place--poster .place__sheet { padding: 1.15rem 1.05rem 0.95rem; }
    .place--poster .place__sheet :global(h1) { margin-bottom: 0.95rem; }
  }

  @media (max-width: 640px) {
    .product-page__hero {
      width: min(76rem, calc(100% - 2rem));
    }
  }
</style>
