---
import type { Lang } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import CountryFlag from './CountryFlag.astro';

interface Frame {
  image: string;
  place: string;
  country: string;
  flag: string;
  credit: string;
  creditHref: string;
  focus?: string;
}

interface Props {
  lang: Lang;
  currentPath: string;
  title: string;
  image?: string;
  place?: string;
  country?: string;
  flag?: string;
  credit?: string;
  creditHref?: string;
  frames?: Frame[];
}

const { lang, currentPath, title, image, place, country, flag, credit, creditHref, frames: passed } = Astro.props;
const frames: Frame[] = passed ?? [{
  image: image ?? '',
  place: place ?? '',
  country: country ?? '',
  flag: flag ?? '',
  credit: credit ?? '',
  creditHref: creditHref ?? '',
  focus: 'center center',
}];
const many = frames.length > 1;
const previous = lang === 'pt' ? 'País anterior' : 'Previous country';
const next = lang === 'pt' ? 'Próximo país' : 'Next country';
---

<BaseLayout lang={lang} currentPath={currentPath} title={title}>
  <section class="place" data-shore={many ? '' : undefined}>
    <div class="place__window">
      <div class="place__reel">
        {frames.map((frame) => (
          <img src={frame.image} alt="" style={`object-position:${frame.focus ?? 'center center'}`} />
        ))}
      </div>
    </div>
    {many && (
      <div class="place__nav">
        <button type="button" class="place__arrow" data-prev aria-label={previous}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="place__arrow" data-next aria-label={next}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    )}
    <div class="place__stack">
      <div class="place__captions" aria-live="polite">
        {frames.map((frame, index) => (
          <div class="place__where" data-where hidden={index !== 0}>
            <CountryFlag code={frame.flag} />
            <div>
              <a class="place__name" href={frame.creditHref}>{frame.place}</a>
              <p class="place__country">{frame.country}</p>
              <p class="place__credit">{frame.credit}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="place__sheet">
        <slot name="sheet" />
      </div>
    </div>
  </section>
  <div class="reading">
    <slot />
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('[data-shore]').forEach((root) => {
    const reel = root.querySelector('.place__reel');
    const slides = [...root.querySelectorAll('[data-where]')];
    if (!reel || slides.length < 2) return;
    let index = 0;
    let timer = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      reel.style.transform = `translateX(${-index * 100}%)`;
      slides.forEach((slide, i) => {
        slide.hidden = i !== index;
      });
    };

    const arm = () => {
      window.clearInterval(timer);
      if (reduced) return;
      timer = window.setInterval(() => show(index + 1), 6500);
    };

    root.querySelector('[data-next]')?.addEventListener('click', () => {
      show(index + 1);
      arm();
    });
    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      show(index - 1);
      arm();
    });
    root.addEventListener('mouseenter', () => window.clearInterval(timer));
    root.addEventListener('mouseleave', arm);
    root.addEventListener('focusin', () => window.clearInterval(timer));
    root.addEventListener('focusout', arm);
    arm();
  });
</script>

<style>
  .place {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
  }

  @media (min-width: 768px) {
    .place { min-height: 100vh; }
  }

  .place__window {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .place__reel {
    display: flex;
    height: 100%;
    transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .place__reel img {
    position: relative;
    flex: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .place__nav {
    position: absolute;
    top: 38%;
    left: 16px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    z-index: 2;
    pointer-events: none;
  }

  .place__arrow {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(16, 22, 20, 0.72);
    color: #f4efe4;
    cursor: pointer;
  }

  .place__arrow svg { width: 22px; height: 22px; }

  .place__arrow:focus-visible {
    outline: 2px solid #f4efe4;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .place__reel { transition: none; }
  }

  .place__stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-5);
    max-width: 40rem;
  }

  .place__sheet {
    width: 100%;
    padding: var(--space-5);
    background: var(--field);
  }

  .place__where {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 6px 6px;
    background: rgba(16, 22, 20, 0.72);
    border-radius: 2px;
    color: #f4efe4;
  }

  .place__where[hidden] { display: none !important; }

  .place__name {
    display: inline-block;
    margin: 0;
    font-family: var(--place);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #f4efe4;
    text-decoration: none;
  }

  .place__name:hover { text-decoration: underline; }

  .place__country {
    margin: 2px 0 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f4efe4;
  }

  .place__sheet :global(h1) {
    margin: 0 0 var(--space-4);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .place__sheet :global(p) {
    margin: 0 0 var(--space-4);
    max-width: 36rem;
  }

  .place__credit {
    margin: 6px 0 0;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: #f4efe4;
  }

  .reading {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .reading :global(p),
  .reading :global(h2) {
    max-width: 42rem;
  }

  .reading :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
    font-family: var(--display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .reading :global(p) { margin: 0 0 var(--space-4); }

  .reading :global(.name) {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
  }
</style>
