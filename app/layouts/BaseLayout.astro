---
import type { Lang } from '../i18n';
import { htmlLang, t } from '../i18n';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  currentPath: string;
  title?: string;
  description?: string;
}

const { lang, currentPath, title = 'SambaPay', description } = Astro.props;
const share = {
  en: 'Local prices, a local signup and a direct connection across South and Central America.',
  pt: 'Preços locais, cadastro local e conexão direta na América do Sul e Central.',
  es: 'Precios locales, registro local y conexión directa en América del Sur y Central.',
}[lang];
const metaDescription = description ?? share;
const messages = t(lang);
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={metaDescription} lang={lang} currentPath={currentPath} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{messages.a11y.skip}</a>
    <SiteHeader lang={lang} currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
